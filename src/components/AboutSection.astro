
---
const contactEmail = "thenaxalarchieve@gmail.com";

const missions = [
  {
    number: "01",
    label: "GIVING VOICE",
    title: "Giving Voice to the Untold Stories",
    description:
      "To document and bring forward the untold stories of victims of Maoist violence, including civilians, security personnel and families whose experiences have often remained unheard.",
  },
  {
    number: "02",
    label: "DOCUMENTING HISTORY",
    title: "Documenting the Rise and Decline of the Movement",
    description:
      "To systematically trace, analyse and document the origins, growth, evolution and decline of the Maoist movement in India through historical records, research and data-driven analysis.",
  },
  {
    number: "03",
    label: "THE HUMAN COST",
    title: "Highlighting the Human Cost of Maoist Violence",
    description:
      "To document the real impact of Maoist violence on individuals, communities and affected regions, highlighting the loss of lives, displacement, disruption of livelihoods and long-term social consequences.",
  },
];

const areas = [
  {
    number: "01",
    title: "History",
    description:
      "Origins of the Naxalite movement, organisational developments, ideological shifts and major turning points.",
    href: "history/",
  },
  {
    number: "02",
    title: "Data & Visuals",
    description:
      "Historical trends, major incidents, casualties, surrenders and other documented developments.",
    href: "data-visuals/",
  },
  {
    number: "03",
    title: "Opinions",
    description:
      "Articles, analysis, interviews and reflections on the movement and its consequences.",
    href: "opinions/",
  },
  {
    number: "04",
    title: "Victims’ Corner",
    description:
      "Personal testimonies and accounts of civilians, security personnel and families affected by Maoist violence.",
    href: "victims-corner/",
  },
  {
    number: "05",
    title: "Tracking Development",
    description:
      "Rehabilitation, infrastructure, governance and changing conditions in formerly affected regions.",
    href: "tracking-development/",
  },
];

const commitments = [
  {
    number: "01",
    title: "Evidence and Attribution",
    description:
      "We aim to support factual claims with identifiable sources and clearly distinguish verified information, reported allegations, personal testimony and editorial interpretation.",
  },
  {
    number: "02",
    title: "Historical Context",
    description:
      "Events are presented within their wider historical, political and social context to help readers understand their causes, developments and consequences.",
  },
  {
    number: "03",
    title: "Dignity and Sensitivity",
    description:
      "Personal stories, particularly those involving violence, trauma and loss, should be presented with sensitivity, respect for privacy and appropriate consideration of consent.",
  },
  {
    number: "04",
    title: "Accuracy and Corrections",
    description:
      "We welcome additional evidence and documented corrections that improve the accuracy, completeness and reliability of the archive.",
  },
];

const base = import.meta.env.BASE_URL;

const pageUrl = (path: string) =>
  `${base}${path.replace(/^\/+/, "")}`;

const emailUrl =
  `mailto:${contactEmail}?subject=Contribution%20to%20The%20Naxal%20Archive`;
---

<div class="about-page" id="about">

  <!-- INTRODUCTION -->
  <section class="about-intro" aria-labelledby="about-title">
    <div class="about-shell">

      <div class="section-label">
        <span class="label-line"></span>
        THE NAXAL ARCHIVE / ABOUT US
      </div>

      <h1 id="about-title">
        History in context.
        <span>People in focus.</span>
      </h1>

      <div class="intro-grid">
        <p class="intro-lead">
          Preserving history. Bringing unheard stories into view.
        </p>

        <div class="intro-copy">
          <p>
            The Naxal Archive is a digital documentation initiative
            dedicated to preserving the history of the Maoist movement
            in India, examining its evolution and decline, and
            recording the experiences of those affected by Maoist
            violence.
          </p>

          <p>
            The archive brings together historical accounts, research,
            data, analysis, interviews and personal testimonies to
            develop a more comprehensive understanding of one of
            India's longest-running internal security challenges.
          </p>

          <p class="intro-emphasis">
            Our purpose is to look beyond statistics and political
            narratives, and place the experiences of people at the
            centre of the historical record.
          </p>
        </div>
      </div>

      <div class="intro-footer">
        <span>HISTORY</span>
        <span class="dot"></span>
        <span>EVIDENCE</span>
        <span class="dot"></span>
        <span>HUMAN STORIES</span>
      </div>

    </div>
  </section>

  <!-- VISION -->
  <section class="vision-section" aria-labelledby="vision-title">
    <div class="about-shell">

      <div class="vision-panel">
        <div class="vision-top">
          <span class="eyebrow">OUR VISION</span>
          <span class="vision-symbol" aria-hidden="true">✳</span>
        </div>

        <div class="vision-content">
          <h2 id="vision-title">
            A fuller record.
            <em>A deeper understanding.</em>
          </h2>

          <div class="vision-description">
            <p>
              To build a comprehensive, accessible and credible digital
              archive that documents the history of Maoism in India,
              preserves the voices of those affected by violence, and
              contributes to a deeper understanding of the movement's
              social, political and human consequences.
            </p>

            <p>
              We envision an archive where historical developments are
              understood through evidence, where personal experiences
              are preserved with dignity, and where future generations
              can examine the movement through both documented events
              and the lives it has affected.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- MISSION -->
  <section class="mission-section" aria-labelledby="mission-title">
    <div class="about-shell">

      <div class="section-intro">
        <div>
          <span class="eyebrow">WHAT GUIDES OUR WORK</span>
          <h2 id="mission-title">
            Our <em>Mission.</em>
          </h2>
        </div>

        <p>
          Three connected priorities guide the work of The Naxal
          Archive: preserving unheard voices, documenting history
          and understanding the human consequences of violence.
        </p>
      </div>

      <div class="mission-grid">
        {missions.map((mission) => (
          <article class="mission-card">

            <div class="mission-card-top">
              <span class="mission-number">{mission.number}</span>
              <span class="mission-line"></span>
            </div>

            <span class="mission-label">{mission.label}</span>

            <h3>{mission.title}</h3>

            <p>{mission.description}</p>

            <div class="mission-bottom"></div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- WHAT WE DOCUMENT -->
  <section
    class="documentation-section"
    aria-labelledby="documentation-title"
  >
    <div class="about-shell">

      <div class="section-intro">
        <div>
          <span class="eyebrow">EXPLORE THE ARCHIVE</span>
          <h2 id="documentation-title">
            What We <em>Document.</em>
          </h2>
        </div>

        <p>
          Different dimensions of the movement are brought together
          through historical documentation, data, analysis and
          first-hand accounts.
        </p>
      </div>

      <div class="documentation-list">
        {areas.map((area) => (
          <a class="documentation-item" href={pageUrl(area.href)}>

            <span class="documentation-number">
              {area.number}
            </span>

            <div class="documentation-text">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>

            <span class="documentation-arrow" aria-hidden="true">
              ↗
            </span>

          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- EDITORIAL COMMITMENTS -->
  <section
    class="principles-section"
    aria-labelledby="principles-title"
  >
    <div class="about-shell">

      <div class="section-intro">
        <div>
          <span class="eyebrow">OUR EDITORIAL APPROACH</span>
          <h2 id="principles-title">
            Trust comes
            <em>from the work.</em>
          </h2>
        </div>

        <p>
          The credibility of a historical archive depends on how
          information is collected, presented and preserved.
          Our editorial approach is guided by four principles.
        </p>
      </div>

      <div class="principles-grid">
        {commitments.map((item) => (
          <article class="principle-item">
            <span class="principle-number">{item.number}</span>

            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- CONTACT -->
  <section
    class="contact-section"
    aria-labelledby="contact-title"
  >
    <div class="about-shell">

      <div class="contact-layout">

        <div class="contact-message">
          <span class="eyebrow">CONTRIBUTE TO THE ARCHIVE</span>

          <h2 id="contact-title">
            Every story
            <em>adds to the record.</em>
          </h2>

          <p>
            Have a historical document, a first-hand account, a
            photograph, a source or a correction to share?
          </p>

          <p>
            We welcome contributions that help preserve overlooked
            experiences, strengthen the historical record and improve
            public understanding of Maoist violence and its consequences.
          </p>

          <div class="contribution-tags">
            <span>Personal accounts</span>
            <span>Historical records</span>
            <span>Sources & corrections</span>
          </div>
        </div>

        <div class="contact-card">
          <div class="contact-card-top">
            <span class="eyebrow">GET IN TOUCH</span>
            <span class="contact-mark" aria-hidden="true">↗</span>
          </div>

          <h3>Share something worth preserving.</h3>

          <p>
            For personal accounts, please begin with a brief
            introduction so that privacy, attribution and any
            publication concerns can be discussed.
          </p>

          <a class="contact-button" href={emailUrl}>
            <span>Contact TheNaxalArchive</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a class="contact-email" href={`mailto:${contactEmail}`}>
            {contactEmail}
          </a>

          <div class="contact-card-footer">
            Submissions are reviewed before inclusion in the archive.
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- END STRIP -->
  <div class="about-end-strip">
    <div class="about-shell end-inner">
      <strong>The Naxal Archive</strong>
      <span>
        Preserving history. Amplifying unheard voices.
        Understanding the human cost of Maoist violence.
      </span>
    </div>
  </div>

</div>

<style>
  .about-page {
    --paper: #f6f2eb;
    --paper-deep: #eee7dc;
    --white: #fffdf9;
    --charcoal: #252629;
    --ink: #24272a;
    --muted: #68625b;
    --copper: #975130;
    --copper-light: #e6b895;
    --line: #dcd3c7;
    --champagne: #eae0d2;

    width: 100%;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
  }

  .about-page *,
  .about-page *::before,
  .about-page *::after {
    box-sizing: border-box;
  }

  .about-shell {
    width: min(1180px, calc(100% - 64px));
    margin-inline: auto;
  }

  .about-page h1,
  .about-page h2,
  .about-page h3,
  .about-page p {
    margin-top: 0;
  }

  .about-page p {
    color: var(--muted);
  }

  .eyebrow,
  .section-label,
  .intro-footer,
  .mission-label,
  .mission-number,
  .documentation-number,
  .principle-number {
    font-family: Arial, Helvetica, sans-serif;
  }

  .eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--copper);
  }

  /* INTRODUCTION */

  .about-intro {
    padding: 112px 0 58px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--copper);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .label-line {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--copper);
  }

  .about-intro h1 {
    max-width: 1080px;
    margin: 30px 0 64px;
    font-size: clamp(54px, 7.2vw, 108px);
    line-height: 0.99;
    letter-spacing: -0.055em;
    font-weight: 700;
    color: var(--charcoal);
  }

  .about-intro h1 span {
    display: block;
    color: var(--copper);
    font-style: italic;
    font-weight: 400;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 84px;
    padding-bottom: 62px;
  }

  .intro-lead {
    max-width: 420px;
    font-size: clamp(26px, 3vw, 39px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--charcoal) !important;
  }

  .intro-copy p {
    margin-bottom: 22px;
    font-size: 17px;
    line-height: 1.85;
  }

  .intro-copy .intro-emphasis {
    margin-top: 30px;
    padding-left: 20px;
    border-left: 3px solid var(--copper);
    color: var(--ink);
    font-weight: 700;
  }

  .intro-footer {
    display: flex;
    align-items: center;
    gap: 15px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    color: var(--copper);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .intro-footer .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--copper);
  }

  /* VISION */

  .vision-section {
    padding: 52px 0 100px;
  }

  .vision-panel {
    background: var(--champagne);
    border: 1px solid #d9cabc;
    padding: 48px 56px 64px;
  }

  .vision-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 38px;
    border-bottom: 1px solid #ccbcaa;
  }

  .vision-symbol {
    font-size: 36px;
    line-height: 1;
    color: var(--copper);
  }

  .vision-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 65px;
    padding-top: 54px;
  }

  .vision-content h2 {
    font-size: clamp(42px, 5vw, 70px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .vision-content h2 em {
    display: block;
    margin-top: 10px;
    color: var(--copper);
    font-weight: 400;
  }

  .vision-description p {
    font-size: 17px;
    line-height: 1.8;
    color: #554d46;
    margin-bottom: 24px;
  }

  /* SHARED SECTION HEADINGS */

  .section-intro {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 44px;
  }

  .section-intro h2 {
    max-width: 650px;
    margin: 13px 0 0;
    font-size: clamp(42px, 5vw, 70px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--charcoal);
  }

  .section-intro h2 em {
    color: var(--copper);
    font-weight: 400;
  }

  .section-intro > p {
    max-width: 440px;
    margin-bottom: 5px;
    font-size: 16px;
    line-height: 1.75;
  }

  /* MISSION */

  .mission-section {
    padding: 25px 0 112px;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 17px;
  }

  .mission-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 460px;
    padding: 30px 30px 35px;
    border: 1px solid var(--line);
    background: var(--white);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .mission-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 42px rgba(40, 32, 24, 0.08);
  }

  .mission-card-top {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 72px;
  }

  .mission-number {
    color: var(--copper);
    font-size: 14px;
    font-weight: 800;
  }

  .mission-line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .mission-label {
    margin-bottom: 17px;
    color: var(--copper);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .mission-card h3 {
    margin-bottom: 20px;
    font-size: clamp(25px, 2.5vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .mission-card p {
    font-size: 15px;
    line-height: 1.8;
  }

  .mission-bottom {
    width: 36px;
    height: 3px;
    margin-top: auto;
    padding-top: 10px;
    border-bottom: 3px solid var(--copper);
  }

  /* DOCUMENTATION */

  .documentation-section {
    padding: 100px 0 116px;
    background: var(--paper-deep);
  }

  .documentation-list {
    border-top: 1px solid #cfc4b6;
  }

  .documentation-item {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 50px;
    gap: 24px;
    align-items: center;
    padding: 30px 10px;
    border-bottom: 1px solid #cfc4b6;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease, padding 0.2s ease;
  }

  .documentation-item:hover {
    background: rgba(255, 255, 255, 0.5);
    padding-inline: 22px;
  }

  .documentation-item:focus-visible,
  .contact-button:focus-visible,
  .contact-email:focus-visible {
    outline: 3px solid var(--copper);
    outline-offset: 4px;
  }

  .documentation-number {
    align-self: start;
    padding-top: 8px;
    color: var(--copper);
    font-size: 13px;
    font-weight: 800;
  }

  .documentation-text h3 {
    margin-bottom: 8px;
    font-size: clamp(26px, 3vw, 38px);
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .documentation-text p {
    max-width: 650px;
    margin-bottom: 0;
    font-size: 15px;
    line-height: 1.65;
  }

  .documentation-arrow {
    justify-self: end;
    font-family: Arial, sans-serif;
    font-size: 25px;
    color: var(--copper);
  }

  /* EDITORIAL COMMITMENTS */

  .principles-section {
    padding: 112px 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 65px;
    margin-top: 35px;
  }

  .principle-item {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 22px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }

  .principle-number {
    padding-top: 4px;
    color: var(--copper);
    font-size: 12px;
    font-weight: 800;
  }

  .principle-item h3 {
    margin-bottom: 14px;
    font-size: 27px;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .principle-item p {
    max-width: 450px;
    margin-bottom: 0;
    font-size: 15px;
    line-height: 1.8;
  }

  /* CONTACT */

  .contact-section {
    padding: 100px 0;
    background: #eee7de;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    gap: 75px;
    align-items: center;
  }

  .contact-message h2 {
    max-width: 650px;
    margin: 22px 0 30px;
    font-size: clamp(45px, 5vw, 68px);
    line-height: 1.06;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .contact-message h2 em {
    display: block;
    color: var(--copper);
    font-weight: 400;
  }

  .contact-message p {
    max-width: 530px;
    margin-bottom: 20px;
    font-size: 17px;
    line-height: 1.8;
    color: #5d554e;
  }

  .contribution-tags {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 35px;
  }

  .contribution-tags span {
    padding: 9px 12px;
    border: 1px solid #cdbfb0;
    border-radius: 30px;
    font: 700 11px/1.3 Arial, sans-serif;
    color: #62564d;
  }

  .contact-card {
    padding: 43px;
    background: var(--charcoal);
    color: #fffaf2;
  }

  .contact-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 45px;
    border-bottom: 1px solid #55504a;
  }

  .contact-card .eyebrow {
    color: #e7b790;
  }

  .contact-mark {
    font: 400 28px/1 Arial, sans-serif;
    color: #e7b790;
  }

  .contact-card h3 {
    margin: 33px 0 20px;
    color: #fffaf2;
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1.13;
    letter-spacing: -0.03em;
  }

  .contact-card p {
    margin-bottom: 33px;
    color: #e2d9ce !important;
    font-size: 15px;
    line-height: 1.8;
  }

  .contact-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 20px;
    background: #f5ede1;
    color: #222427;
    text-decoration: none;
    font: 800 14px/1.35 Arial, sans-serif;
    transition: background 0.2s ease;
  }

  .contact-button:hover {
    background: #e7b790;
  }

  .contact-button span:last-child {
    font-size: 24px;
  }

  .contact-email {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 25px 0;
    color: #fffaf2;
    font: 500 14px/1.5 Arial, sans-serif;
    overflow-wrap: anywhere;
    text-decoration-color: #e7b790;
    text-underline-offset: 5px;
  }

  .contact-card-footer {
    padding-top: 20px;
    border-top: 1px solid #55504a;
    color: #d7cdc1;
    font: 500 12px/1.7 Arial, sans-serif;
  }

  /* BOTTOM STRIP */

  .about-end-strip {
    padding: 25px 0;
    background: #222427;
  }

  .end-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .end-inner strong {
    color: #fffaf2;
    font-size: 22px;
  }

  .end-inner span {
    max-width: 600px;
    color: #d9d0c4;
    font: 500 12px/1.6 Arial, sans-serif;
    text-align: right;
  }

  /* TABLET */

  @media (max-width: 960px) {
    .about-shell {
      width: min(100% - 44px, 1180px);
    }

    .intro-grid,
    .vision-content,
    .section-intro,
    .contact-layout {
      gap: 35px;
    }

    .mission-grid {
