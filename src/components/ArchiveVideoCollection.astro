---
import { archiveVideos, youtubeThumbnail, youtubeWatchUrl } from '../data/archiveVideos';
import type { ArchiveVideo } from '../data/archiveVideos';

type Mode = 'home' | 'interviews' | 'victims';
interface Props { mode: Mode }
const { mode } = Astro.props;
const interviews = archiveVideos.filter((item) => item.kind === 'interview');
const victims = archiveVideos.filter((item) => item.kind === 'victim');
const entries = mode === 'interviews'
  ? interviews
  : mode === 'victims'
    ? victims
    : [interviews[0], victims[0]].filter((v): v is ArchiveVideo => Boolean(v));
const headingId = `archive-videos-${mode}`;
const heading = mode === 'home'
  ? 'Voices from the archive.'
  : mode === 'interviews'
    ? 'Conversations after surrender.'
    : 'Stories behind the conflict.';
const intro = mode === 'home'
  ? 'Watch interviews and testimony from the people whose experiences form part of the historical record.'
  : mode === 'interviews'
    ? 'First-person perspectives shared in interviews with former members of the Maoist movement.'
    : 'Video reports and accounts concerning security-force victims and the wider human impact of the conflict.';
const smallLabel = mode === 'interviews'
  ? 'OPINIONS / VIDEO INTERVIEWS'
  : mode === 'victims'
    ? 'VICTIMS\u2019 CORNER / WATCH'
    : 'THE NAXAL ARCHIVE / VIDEO STORIES';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const route = (path: string) => `${base}/${path.replace(/^\/+/, '')}`;
---
<section class:list={['av-section', `av-${mode}`]} id={mode === 'home' ? 'voices' : mode === 'interviews' ? 'interviews' : 'video-stories'} aria-labelledby={headingId}>
  <div class="av-shell">
    <header class="av-section-head">
      <div>
        <span class="av-eyebrow"><span class="av-mark" aria-hidden="true"></span>{smallLabel}</span>
        <h2 id={headingId}>{heading}</h2>
        <p>{intro}</p>
      </div>
      {mode === 'home' && (
        <div class="av-section-links">
          <a href={route('articles/#interviews')}>Explore interviews <span aria-hidden="true">&#8599;</span></a>
          <a href={route('victims-corner/')}>Visit Victims&rsquo; Corner <span aria-hidden="true">&#8599;</span></a>
        </div>
      )}
    </header>

    <div class="av-grid">
      {entries.map((video, index) => (
        <article class="av-card">
          <a class="av-media" href={youtubeWatchUrl(video)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.title} on YouTube (opens in new tab)`}>
            <span class="av-fallback" aria-hidden="true"><span>THE NAXAL ARCHIVE</span><strong>{video.kind === 'interview' ? 'Interview' : 'Testimony'}</strong></span>
            <img src={youtubeThumbnail(video)} alt={`YouTube thumbnail for ${video.title}`} loading="lazy" decoding="async" data-av-image />
            <span class="av-play" aria-hidden="true">&#9654;</span>
          </a>
          <div class="av-content">
            <div class="av-meta">
              <span>{video.kind === 'interview' ? 'INTERVIEW' : 'VIDEO STORY'}</span>
              <span>YOUTUBE</span>
            </div>
            <h3>{video.title}</h3>
            <p class="av-context">{video.context}</p>
            <p class="av-description">{video.description}</p>
            <div class="av-footer">
              <span class="av-status">{video.publisher ? `Courtesy: ${video.publisher}` : 'Original video on YouTube'}</span>
              <a href={youtubeWatchUrl(video)} target="_blank" rel="noopener noreferrer">Watch original <span aria-hidden="true">&#8599;</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>

   
  </div>
</section>

<script>
  // Do not display broken-image icons if a YouTube thumbnail is unavailable.
  document.querySelectorAll<HTMLImageElement>('[data-av-image]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0) {
      img.remove();
    } else {
      img.addEventListener('error', () => img.remove(), { once: true });
    }
  });
</script>

<style>
  .av-section{--av-ink:#182b25;--av-rust:#af583d;--av-border:#d8d0c4;--av-muted:#66675e;background:#f8f4ec;color:var(--av-ink);padding:clamp(52px,7vw,92px) 0;}
  .av-home{background:#eae6db;border-top:1px solid #d5cdc1;border-bottom:1px solid #d5cdc1;}
  .av-interviews{border-top:1px solid #ded5c8;background:#f6f1e8;}
  .av-victims{background:#f5f0e7;}
  .av-shell{width:min(1180px,calc(100% - 40px));margin:0 auto;}
  .av-section-head{display:flex;justify-content:space-between;align-items:end;gap:36px;margin-bottom:30px;}
  .av-section-head>div:first-child{max-width:780px;}
  .av-eyebrow{display:flex;align-items:center;gap:9px;font:800 10px/1.4 system-ui,sans-serif;letter-spacing:.14em;color:var(--av-rust);}
  .av-mark{display:inline-block;width:8px;height:8px;border-radius:50%;background:#bf6d46;}
  .av-section-head h2{font:600 clamp(34px,4.3vw,59px)/1.04 Georgia,serif;letter-spacing:-.045em;margin:14px 0 13px;}
  .av-section-head p{font:16px/1.65 Georgia,serif;color:#5c655e;margin:0;max-width:720px;}
  .av-section-links{display:flex;flex-direction:column;gap:9px;flex-shrink:0;align-items:flex-end;}
  .av-section-links a{font:750 12px/1.3 system-ui,sans-serif;color:#20493d;text-decoration:none;padding-bottom:9px;border-bottom:1px solid #bdc5b9;white-space:nowrap;}
  .av-section-links a:hover{color:var(--av-rust);}
  .av-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;}
  .av-home .av-grid,.av-interviews .av-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .av-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;background:#fffdf8;border:1px solid #ddd4c6;border-radius:8px;box-shadow:0 10px 28px rgba(37,41,32,.035);transition:transform .2s ease,box-shadow .2s ease;}
  .av-card:hover{transform:translateY(-3px);box-shadow:0 16px 32px rgba(37,41,32,.09);}
  .av-media{height:auto;display:block;position:relative;aspect-ratio:16 / 9;overflow:hidden;background:linear-gradient(137deg,#315647,#183b31 60%,#102921);color:#fff;}
  .av-media img{position:absolute;z-index:1;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s ease;}
  .av-media:hover img{transform:scale(1.035);}
  .av-fallback{position:absolute;inset:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:27px;color:#f8eddd;}
  .av-fallback span{font:800 10px/1 system-ui,sans-serif;letter-spacing:.12em;color:#e8c49f;}
  .av-fallback strong{font:italic 600 clamp(28px,3vw,41px)/1.1 Georgia,serif;margin-top:10px;}
  .av-play{position:absolute;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:60px;height:60px;padding-left:3px;border:1px solid rgba(255,255,255,.75);border-radius:50%;background:rgba(21,39,33,.76);color:#fff;font:23px/1 system-ui,sans-serif;box-shadow:0 5px 25px rgba(0,0,0,.2);}
  .av-image-number{position:absolute;z-index:2;bottom:13px;left:16px;color:#fff;background:rgba(18,35,30,.83);border-radius:3px;padding:5px 8px;font:750 10px/1 system-ui,sans-serif;}
  .av-content{display:flex;flex-direction:column;flex:1;padding:22px 23px 20px;}
  .av-meta{display:flex;justify-content:space-between;gap:15px;color:#b35d3d;font:800 9px/1.4 system-ui,sans-serif;letter-spacing:.1em;}
  .av-meta span:last-child{color:#79776d;}
  .av-content h3{font:600 clamp(21px,2vw,27px)/1.16 Georgia,serif;letter-spacing:-.025em;margin:15px 0 10px;}
  .av-context{font:750 11px/1.4 system-ui,sans-serif;color:#6e756b;margin:0 0 14px;}
  .av-description{font:14px/1.6 Georgia,serif;color:#58635c;flex:1;margin:0 0 20px;}
  .av-footer{border-top:1px solid #e6dfd3;padding-top:15px;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;}
  .av-status{font:700 10px/1.4 system-ui,sans-serif;color:#8a8175;}
  .av-footer a{font:800 11px/1.3 system-ui,sans-serif;color:#1e473a;text-decoration:none;white-space:nowrap;}
  .av-footer a:hover{color:var(--av-rust);}
  
  @media(max-width:1000px){.av-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.av-section-head{align-items:start;}}
  @media(max-width:700px){.av-section-head{flex-direction:column;align-items:stretch;gap:18px;}.av-section-links{align-items:flex-start;}.av-grid,.av-home .av-grid,.av-interviews .av-grid{grid-template-columns:1fr;}.av-content{padding:20px;}.av-section-head h2{font-size:38px;}.av-play{width:54px;height:54px;}.av-media{aspect-ratio:16/9;}}
  @media(prefers-reduced-motion:reduce){.av-card,.av-media img{transition:none;}}
</style>
