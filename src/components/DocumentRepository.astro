---
import { historyDocuments } from '../data/historyDocuments';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const documents = [...historyDocuments].sort(
  (a, b) => (a.displayOrder ?? 999) - (b.displayOrder ?? 999) ||
    (b.year ?? 0) - (a.year ?? 0) || a.title.localeCompare(b.title)
);
const categories = [...new Set(documents.map((item) => item.category))].sort();
const pdfPath = (item: (typeof documents)[number]) =>
  item.localPdfPath ? url(item.localPdfPath) : item.pdfUrl;
const isPublicPdf = (item: (typeof documents)[number]) =>
  item.access === 'public-pdf' &&
  Boolean(pdfPath(item));
---

<section class="dr-page" data-document-repository aria-labelledby="dr-heading">
  <div class="dr-shell">
    <nav class="dr-breadcrumb" aria-label="Breadcrumb">
      <a href={url()}>Home</a><span aria-hidden="true">/</span>
      <a href={url('history/')}>History</a><span aria-hidden="true">/</span>
      <span aria-current="page">Documents</span>
    </nav>

    <header class="dr-intro">
      <span class="dr-eyebrow">HISTORY / DOCUMENTS &amp; RECORDS</span>
      <h1 id="dr-heading">Document Repository</h1>
      <p>A consolidated collection of historical documents, ideological texts, official records and research publications relating to the Maoist insurgency in India.</p>
    </header>

    <div class="dr-toolbar" role="search" aria-label="Search and filter documents">
      <div class="dr-field dr-field-search">
        <label for="dr-search">Search documents</label>
        <div class="dr-input-wrap">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
          <input id="dr-search" type="search" placeholder="Search title, year, source or keyword" autocomplete="off" />
        </div>
      </div>
      <div class="dr-field dr-field-category">
        <label for="dr-category">Category</label>
        <select id="dr-category">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>
    </div>

    <div class="dr-list-heading">
      <p id="dr-count" aria-live="polite">Showing {documents.length} {documents.length === 1 ? 'document' : 'documents'}</p>
      <button id="dr-clear" type="button" hidden>Clear filters <span aria-hidden="true">×</span></button>
    </div>

    <ol class="dr-list" id="dr-list">
      {documents.map((item) => (
        <li
          class="dr-item"
          data-category={item.category}
          data-search={[item.title, item.year ?? '', item.category, item.sourceName, item.description].join(' ').toLowerCase()}
        >
          <div class="dr-side">
            <span class="dr-year">{item.year ?? 'Undated'}</span>
            <span class="dr-category">{item.category}</span>
          </div>
          <div class="dr-details">
            <h2>{item.title}</h2>
            <p class="dr-description">{item.description}</p>
            <p class="dr-source"><span>Original source:</span> {item.sourceName}</p>
          </div>
          <div class="dr-actions">
            {isPublicPdf(item) && (
              <>
                <a class="dr-action dr-action-primary" href={pdfPath(item)} target="_blank" rel="noopener noreferrer">
                  View PDF <span aria-hidden="true">↗</span>
                </a>
                {item.localPdfPath ? (
                  <a class="dr-action" href={pdfPath(item)} download>
                    Download PDF <span aria-hidden="true">↓</span>
                  </a>
                ) : (
                  <a class="dr-action" href={pdfPath(item)} target="_blank" rel="noopener noreferrer" title="Opens the publisher's PDF. Use your browser's download control to save it.">
                    Download PDF <span aria-hidden="true">↗</span>
                  </a>
                )}
              </>
            )}
            {item.access === 'summary-only' ? (
              <span class="dr-summary-note">Contextual summary only</span>
            ) : item.sourceUrl ? (
              <a class="dr-action dr-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                Original source <span aria-hidden="true">↗</span>
              </a>
            ) : null}
            {item.access === 'public-pdf' && !isPublicPdf(item) && (
              <span class="dr-summary-note">PDF currently unavailable</span>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="dr-empty" id="dr-empty" role="status" hidden>No documents match your search. Try another keyword or category.</p>
    <p class="dr-access-note">These five PDFs are presented as historical primary-source material for research and documentation. Their inclusion does not indicate endorsement of the organisation or the views expressed.</p>
  </div>
</section>

<script>
  const root = document.querySelector('[data-document-repository]');
  if (root) {
    const search = root.querySelector('#dr-search');
    const category = root.querySelector('#dr-category');
    const count = root.querySelector('#dr-count');
    const clear = root.querySelector('#dr-clear');
    const empty = root.querySelector('#dr-empty');
    const items = Array.from(root.querySelectorAll('.dr-item'));

    if (search instanceof HTMLInputElement &&
        category instanceof HTMLSelectElement &&
        count && clear instanceof HTMLButtonElement && empty) {
      const update = () => {
        const query = search.value.trim().toLowerCase().normalize('NFKD');
        const chosen = category.value;
        let shown = 0;
        items.forEach((item) => {
          const haystack = (item.getAttribute('data-search') || '').normalize('NFKD');
          const matches = (!query || haystack.includes(query)) &&
            (!chosen || item.getAttribute('data-category') === chosen);
          item.hidden = !matches;
          if (matches) shown++;
        });
        count.textContent = `Showing ${shown} of ${items.length} ${items.length === 1 ? 'document' : 'documents'}`;
        empty.hidden = shown !== 0;
        clear.hidden = !query && !chosen;
      };
      search.addEventListener('input', update);
      category.addEventListener('change', update);
      clear.addEventListener('click', () => {
        search.value = '';
        category.value = '';
        update();
        search.focus();
      });
    }
  }
</script>

<style>
  .dr-page{--dr-ink:#19352b;--dr-rust:#aa5539;--dr-muted:#5f6b63;--dr-border:#d8cebf;background:#f3efe6;color:var(--dr-ink);min-height:72vh;padding:0 0 60px;}
  .dr-shell{width:min(1160px,calc(100% - 44px));margin:0 auto;}
  .dr-breadcrumb{display:flex;align-items:center;gap:12px;padding:23px 0 29px;color:#82786b;font:600 11px/1.5 system-ui,sans-serif;}
  .dr-breadcrumb a{color:inherit;text-decoration:none;}.dr-breadcrumb a:hover{color:var(--dr-rust);}
  .dr-intro{border-bottom:1px solid var(--dr-border);padding:0 0 28px;margin-bottom:25px;}
  .dr-eyebrow{color:var(--dr-rust);font:800 10px/1.4 system-ui,sans-serif;letter-spacing:.14em;}
  .dr-intro h1{font:700 clamp(36px,4.4vw,56px)/1.08 Georgia,serif;letter-spacing:-.045em;margin:12px 0 14px;}
  .dr-intro p{font:16px/1.65 Georgia,serif;color:#526258;max-width:880px;margin:0;}
  .dr-toolbar{display:grid;grid-template-columns:minmax(0,1fr) minmax(200px,270px);gap:16px;align-items:end;margin-bottom:16px;}
  .dr-field{display:flex;flex-direction:column;gap:7px;min-width:0;}
  .dr-field label{font:750 11px/1.35 system-ui,sans-serif;color:#344c41;}
  .dr-input-wrap{position:relative;}
  .dr-input-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#817b70;pointer-events:none;}
  .dr-input-wrap input,.dr-field select{box-sizing:border-box;width:100%;height:44px;border:1px solid #cfc4b4;border-radius:5px;background:#fffdf8;color:#1b332b;font:500 13px/1.3 system-ui,sans-serif;outline:none;}
  .dr-input-wrap input{padding:0 14px 0 43px;}.dr-field select{padding:0 34px 0 13px;cursor:pointer;}
  .dr-input-wrap input:focus,.dr-field select:focus{border-color:var(--dr-rust);box-shadow:0 0 0 3px rgba(170,85,57,.12);}
  .dr-list-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:35px;margin-bottom:8px;}
  .dr-list-heading p{font:650 11px/1.4 system-ui,sans-serif;color:#687267;margin:0;}
  .dr-list-heading button{font:700 11px/1.4 system-ui,sans-serif;color:var(--dr-rust);border:0;background:none;cursor:pointer;padding:5px 0;}
  .dr-list-heading button:hover{text-decoration:underline;}
  .dr-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--dr-border);}
  .dr-item{display:grid;grid-template-columns:150px minmax(0,1fr) 164px;gap:22px;align-items:start;border-bottom:1px solid var(--dr-border);padding:20px 0;min-width:0;}
  .dr-item[hidden],.dr-empty[hidden],.dr-list-heading button[hidden]{display:none!important;}
  .dr-side{display:flex;flex-direction:column;gap:9px;align-items:flex-start;padding-top:4px;}
  .dr-year{color:var(--dr-rust);font:800 15px/1.2 system-ui,sans-serif;letter-spacing:.015em;}
  .dr-category{font:700 10px/1.4 system-ui,sans-serif;color:#6d7169;}
  .dr-details h2{font:700 clamp(18px,2vw,22px)/1.25 Georgia,serif;letter-spacing:-.018em;margin:0 0 8px;}
  .dr-description{font:14px/1.55 Georgia,serif;color:#5b665e;margin:0 0 9px;}
  .dr-source{font:600 11px/1.55 system-ui,sans-serif;color:#667068;margin:0;}
  .dr-source span{color:#8c6250;font-weight:750;}
  .dr-actions{display:flex;flex-direction:column;align-items:flex-start;gap:7px;padding-top:2px;}
  .dr-action{font:750 11px/1.4 system-ui,sans-serif;color:#25483b;text-decoration:none;padding:4px 0;}
  .dr-action span{color:var(--dr-rust);margin-left:3px;}
  .dr-action:hover{color:var(--dr-rust);text-decoration:underline;text-underline-offset:3px;}
  .dr-action-primary{font-weight:800;}
  .dr-source-link{color:#7b6c5f;}
  .dr-summary-note{font:650 11px/1.5 system-ui,sans-serif;color:#7e6f62;}
  .dr-empty{border:1px dashed #cbbcab;background:#faf7f0;padding:25px 20px;text-align:center;color:#5b645b;font:14px/1.6 Georgia,serif;margin:15px 0;}
  .dr-access-note{font:11px/1.65 system-ui,sans-serif;color:#7d7b72;margin:19px 0 0;max-width:850px;}
  @media(max-width:820px){.dr-item{grid-template-columns:110px minmax(0,1fr);gap:16px;}.dr-actions{grid-column:2;flex-direction:row;flex-wrap:wrap;gap:8px 18px;padding-top:0;}}
  @media(max-width:600px){.dr-shell{width:calc(100% - 28px);}.dr-breadcrumb{padding:17px 0 25px;}.dr-intro{padding-bottom:22px;margin-bottom:20px;}.dr-intro h1{font-size:clamp(34px,9vw,43px);}.dr-intro p{font-size:15px;}.dr-toolbar{grid-template-columns:1fr;gap:12px;}.dr-item{grid-template-columns:1fr;gap:8px;padding:17px 0;}.dr-side{flex-direction:row;align-items:center;gap:12px;padding:0;}.dr-year{font-size:13px;}.dr-details h2{font-size:20px;}.dr-actions{grid-column:1;gap:6px 17px;}.dr-action{padding:6px 0;}.dr-page{padding-bottom:36px;}}
  @media(prefers-reduced-motion:reduce){.dr-action{scroll-behavior:auto;}}
</style>
