@media(max-width:760px){.mi-hero{grid-template-columns:1fr}.mi-hero-content{padding:34px;min-height:350px}.mi-hero-art{position:absolute;inset:0;opacity:.38;z-index:-1}.mi-hero-art::after{background:linear-gradient(90deg,#153c31 0%,rgba(21,60,49,.7) 60%,rgba(21,60,49,.25))}.mi-hero-stamp{display:none}.mi-hero h2{max-width:620px}.mi-context-strip{align-items:flex-start}.mi-context-coverage{display:none}.mi-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.mi-workspace-head{padding:24px}.mi-breakdowns{grid-template-columns:1fr}.mi-breakdown{display:grid;grid-template-columns:180px 1fr;column-gap:20px;align-items:center}.mi-breakdown h4{grid-column:1/-1}.mi-donut{margin:0}.mi-source{grid-template-columns:1fr}}
@media(max-width:520px){.mi-shell{width:calc(100% - 26px)}.mi-section{padding-top:30px}.mi-breadcrumb{font-size:9px;gap:7px}.mi-hero{border-radius:12px}.mi-hero-content{padding:29px 23px;min-height:355px}.mi-hero h2{font-size:clamp(37px,9.8vw,49px)}.mi-hero-description{font-size:14px}.mi-hero-tags{gap:6px}.mi-hero-tags>span{padding:7px 9px;font-size:9px}.mi-context-strip{padding:18px 0;margin-bottom:24px}.mi-context-primary p{font-size:11px}.mi-section-heading{align-items:start}.mi-section-heading>p{font-size:10px;max-width:120px;text-align:right}.mi-stats{gap:9px;margin-bottom:24px}.mi-stat{min-height:156px;padding:15px 13px;border-radius:10px}.mi-stat-icon{width:31px;height:31px}.mi-stat-icon svg{width:17px;height:17px}.mi-stat-index{font-size:7px}.mi-stat strong{font-size:35px;margin-top:10px}.mi-stat-label{font-size:11px}.mi-stat small{font-size:9px}.mi-workspace-head{padding:22px 18px 20px}.mi-workspace-head h3{font-size:28px}.mi-controls{width:100%;gap:7px}.mi-select-wrap select{min-width:87px}.mi-tabs{padding:0 8px}.mi-tabs button{padding:15px 11px;font-size:11px}.mi-tab-icon{font-size:16px}.mi-range-bar{padding:12px 18px}.mi-range-note{display:none}.mi-panel{padding:20px 15px}.mi-panel-heading{align-items:start}.mi-section h4{font-size:26px}.mi-chart-card{padding:9px 4px 0}.mi-chart{min-height:175px}.mi-chart-insights>div{padding:12px 7px}.mi-chart-insights span{font-size:7px}.mi-chart-insights strong{font-size:18px}.mi-chart-insights small{font-size:9px}.mi-breakdown{display:block;padding:18px}.mi-donut{margin:0 auto 18px}.mi-source{gap:10px}.mi-source>div{padding:16px}.mi-chart-note{font-size:10px}}
@media(prefers-reduced-motion:reduce){.mi-stat,.mi-reset,.mi-export{transition:none}}
</style>

<script>
  type DataRow = {
    year: number; incidents: number;
    killedCivilian: number; killedSecurity: number; killedMilitant: number; killedNS: number; killedTotal: number;
    injuredCivilian: number; injuredSecurity: number; injuredMilitant: number; injuredNS: number; injuredTotal: number;
    initiatedCivilian: number; initiatedSecurity: number; initiatedMilitant: number; initiatedNS: number;
  };
  type Metric = keyof Omit<DataRow,'year'>;
  const fields: Metric[] = [
    'incidents','killedCivilian','killedSecurity','killedMilitant','killedNS','killedTotal',
    'injuredCivilian','injuredSecurity','injuredMilitant','injuredNS','injuredTotal',
    'initiatedCivilian','initiatedSecurity','initiatedMilitant','initiatedNS'
  ];
  const labels = [
    'Year','Incidents','Killed: civilians','Killed: security forces','Killed: militants',
    'Killed: not specified','Killed: total','Injured: civilians','Injured: security forces',
    'Injured: militants','Injured: not specified','Injured: total','Initiated by: civilians',
    'Initiated by: security forces','Initiated by: militants','Initiated by: not specified'
  ];
  const nf = (n: number) => n.toLocaleString('en-IN');
  const svgNS = 'http://www.w3.org/2000/svg';
  const svgNode = (tag: string, attrs: Record<string,string | number>, text?: string): SVGElement => {
    const el = document.createElementNS(svgNS, tag);
    for (const [k,v] of Object.entries(attrs)) el.setAttribute(k,String(v));
    if (text !== undefined) el.textContent = text;
    return el;
  };
  const niceMax = (n: number) => {
    if (n <= 0) return 4;
    const magnitude = Math.pow(10,Math.floor(Math.log10(n)));
    const unit = n / magnitude;
    const nice = unit <= 1 ? 1 : unit <= 2 ? 2 : unit <= 2.5 ? 2.5 : unit <= 5 ? 5 : 10;
    return nice * magnitude;
  };
  document.querySelectorAll<HTMLElement>('[data-major-incidents]').forEach((root) => {
    if (root.dataset.ready === 'yes') return;
    root.dataset.ready = 'yes';
    const all = JSON.parse(root.dataset.rows || '[]') as DataRow[];
    const startEl = root.querySelector<HTMLSelectElement>('[data-start]')!;
    const endEl = root.querySelector<HTMLSelectElement>('[data-end]')!;
    const metricEl = root.querySelector<HTMLSelectElement>('[data-metric]')!;
    const rangeEl = root.querySelector<HTMLElement>('[data-range]')!;
    const chartEl = root.querySelector<HTMLElement>('[data-chart]')!;
    const breakdownEl = root.querySelector<HTMLElement>('[data-breakdowns]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const filtered = () => all.filter(r => r.year >= +startEl.value && r.year <= +endEl.value);
    const sum = (rows: DataRow[], field: Metric) => rows.reduce((a,r) => a + r[field],0);
    const currentTotals = (rows: DataRow[]) => Object.fromEntries(fields.map(f => [f,sum(rows,f)])) as Record<Metric,number>;

    function drawChart(rows: DataRow[]) {
      chartEl.replaceChildren();
      const metric = metricEl.value as Metric;
      const metricLabel = metricEl.selectedOptions[0].textContent || metric;
      const width=900,height=345,left=67,right=25,top=26,bottom=52;
      const innerW=width-left-right,innerH=height-top-bottom;
      const values=rows.map(r=>r[metric]);
      const peak=rows.reduce<DataRow | null>((best,r)=>!best||r[metric]>best[metric]?r:best,null);
      const peakYear=root.querySelector<HTMLElement>('[data-peak-year]');
      const peakValue=root.querySelector<HTMLElement>('[data-peak-value]');
      const yearsCount=root.querySelector<HTMLElement>('[data-years-count]');
      const measureName=root.querySelector<HTMLElement>('[data-measure-name]');
      if(peakYear) peakYear.textContent=peak?String(peak.year):'—';
      if(peakValue) peakValue.textContent=peak?`${nf(peak[metric])} ${metricLabel.toLowerCase()}`:'No data';
      if(yearsCount) yearsCount.textContent=String(rows.length);
      if(measureName) measureName.textContent=metricLabel;
      const yMax=niceMax(Math.max(...values,0));
      const x = (i:number) => left + (rows.length===1 ? innerW/2 : i*innerW/(rows.length-1));
      const y = (n:number) => top+innerH-(n/yMax)*innerH;
      const svg=svgNode('svg',{viewBox:`0 0 ${width} ${height}`,role:'img','aria-label':`${metricLabel} by year from ${rows[0]?.year} to ${rows[rows.length-1]?.year}`});
      svg.append(svgNode('title',{},`${metricLabel}, ${rows[0]?.year} to ${rows[rows.length-1]?.year}`));
      for(let i=0;i<=4;i++) {
        const val=yMax*i/4;
        const yy=y(val);
        svg.append(svgNode('line',{x1:left,y1:yy,x2:width-right,y2:yy,stroke:'#e9e4d9','stroke-width':1}));
        svg.append(svgNode('text',{x:left-13,y:yy+4,'text-anchor':'end','font-size':12,fill:'#697d6d','font-family':'system-ui'},nf(val)));
      }
      const tickEvery = rows.length>19 ? 4 : rows.length>10 ? 2 : 1;
      rows.forEach((r,i)=> {
        if(i%tickEvery===0 || i===rows.length-1) {
          svg.append(svgNode('text',{x:x(i),y:height-19,'text-anchor':'middle','font-size':12,fill:'#697d6d','font-family':'system-ui'},String(r.year)));
        }
      });
      const points=rows.map((r,i)=>[x(i),y(r[metric])] as [number,number]);
      if(points.length>1) {
        const area=`M ${points[0][0]} ${top+innerH} L ${points.map(p=>p.join(' ')).join(' L ')} L ${points[points.length-1][0]} ${top+innerH} Z`;
        svg.append(svgNode('path',{d:area,fill:'#b84e2c','fill-opacity':'.09'}));
        svg.append(svgNode('polyline',{points:points.map(p=>p.join(',')).join(' '),fill:'none',stroke:'#b84e2c','stroke-width':3.4,'stroke-linejoin':'round','stroke-linecap':'round'}));
      }
      rows.forEach((r,i)=> {
        const circle=svgNode('circle',{cx:x(i),cy:y(r[metric]),r:rows.length>20?4.1:5.2,fill:'#b84e2c',stroke:'#fffdf8','stroke-width':1.6,tabindex:0,role:'img','aria-label':`${r.year}: ${nf(r[metric])} ${metricLabel.toLowerCase()}`});
        circle.append(svgNode('title',{},`${r.year}: ${nf(r[metric])} ${metricLabel.toLowerCase()}`));
        svg.append(circle);
      });
      svg.append(svgNode('text',{x:width/2,y:height-1,'text-anchor':'middle','font-size':12,fill:'#697d6d','font-family':'system-ui'},'Year'));
      chartEl.append(svg);
    }

    const palettes=['#b84e2c','#285648','#c58a2c','#78998b','#9a9c94'];
    function drawBreakdown(rows:DataRow[]) {
      breakdownEl.replaceChildren();
      const totals=currentTotals(rows);
      const groups:[string,[string,number][],number][] = [
        ['Killed',[['Civilians',totals.killedCivilian],['Security forces',totals.killedSecurity],['Militants',totals.killedMilitant],['Not specified',totals.killedNS]],totals.killedTotal],
        ['Injured',[['Civilians',totals.injuredCivilian],['Security forces',totals.injuredSecurity],['Militants',totals.injuredMilitant],['Not specified',totals.injuredNS]],totals.injuredTotal],
        ['Initiated by',[['Civilians',totals.initiatedCivilian],['Security forces',totals.initiatedSecurity],['Militants',totals.initiatedMilitant],['Not specified',totals.initiatedNS],['Not assigned (calculated)',Math.max(0,totals.incidents-totals.initiatedCivilian-totals.initiatedSecurity-totals.initiatedMilitant-totals.initiatedNS)]],totals.incidents],
      ];
      groups.forEach(([title,items,grand]) => {
        const panel=document.createElement('div'); panel.className='mi-breakdown';
        const heading=document.createElement('h4');heading.textContent=title;panel.append(heading);
        const donut=document.createElement('div');donut.className='mi-donut';
        let cursor=0;
        const stops=items.map(([,value],i)=>{const from=cursor;cursor+=grand?value/grand*100:0;return `${palettes[i]} ${from.toFixed(4)}% ${cursor.toFixed(4)}%`;});
        donut.style.background=grand?`conic-gradient(${stops.join(',')})`:'#e7e2d9';
        const inner=document.createElement('div');inner.className='mi-donut-center';
        const grandNumber=document.createElement('strong');grandNumber.textContent=nf(grand);
        const grandLabel=document.createElement('span');grandLabel.textContent=title==='Initiated by'?'Incidents':'People';
        inner.append(grandNumber,grandLabel);donut.append(inner);panel.append(donut);
        items.forEach(([label,value],i) => {
          const row=document.createElement('div');row.className='mi-breakdown-row';
          const meta=document.createElement('div');meta.className='mi-breakdown-meta';
          const name=document.createElement('span');name.className='mi-legend-name';
          const dot=document.createElement('span');dot.className='mi-legend-dot';dot.style.background=palettes[i];
          const nameText=document.createElement('span');nameText.textContent=label;name.append(dot,nameText);
          const count=document.createElement('strong');count.textContent=`${nf(value)} · ${grand?((value/grand)*100).toFixed(1):'0.0'}%`;
          meta.append(name,count);
          const track=document.createElement('div');track.className='mi-breakdown-track';
          const fill=document.createElement('div');fill.className='mi-breakdown-fill';fill.style.width=`${grand?value/grand*100:0}%`;fill.style.background=palettes[i];
          track.append(fill);row.append(meta,track);panel.append(row);
        });
        breakdownEl.append(panel);
      });
    }

    function update() {
      const rows=filtered();
      const totals=currentTotals(rows);
      rangeEl.textContent=`Showing ${startEl.value}–${endEl.value} · ${rows.length} reporting year${rows.length===1?'':'s'}`;
      root.querySelectorAll<HTMLElement>('[data-stat]').forEach(el=>{
        const field=el.dataset.stat as Metric;
        el.textContent=nf(totals[field]||0);
      });
      root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-year]').forEach(tr=>{
        tr.hidden=+tr.dataset.year! < +startEl.value || +tr.dataset.year! > +endEl.value;
      });
      root.querySelectorAll<HTMLElement>('[data-total]').forEach(el=>{
        el.textContent=nf(totals[el.dataset.total as Metric]||0);
      });
      drawChart(rows);drawBreakdown(rows);
    }
    startEl.addEventListener('change',()=>{
      if(+startEl.value > +endEl.value) endEl.value=startEl.value;
      update();
    });
    endEl.addEventListener('change',()=>{
      if(+endEl.value < +startEl.value) startEl.value=endEl.value;
      update();
    });
    root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click',()=>{
      startEl.value=String(all[0].year);endEl.value=String(all[all.length-1].year);update();
    });
    metricEl.addEventListener('change',()=>drawChart(filtered()));
    const activate=(tab:HTMLButtonElement)=>{
      tabs.forEach(t=>{
        const selected=t===tab;
        t.setAttribute('aria-selected',String(selected));
        t.tabIndex=selected?0:-1;
        const panel=root.querySelector<HTMLElement>(`[data-panel="${t.dataset.tab}"]`);
        if(panel) panel.hidden=!selected;
      });
    };
    tabs.forEach((tab,i)=>{
      tab.addEventListener('click',()=>activate(tab));
      tab.addEventListener('keydown',(e)=>{
        if(e.key!=='ArrowRight' && e.key!=='ArrowLeft' && e.key!=='Home' && e.key!=='End')return;
        e.preventDefault();
        const next=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;
        activate(tabs[next]);tabs[next].focus();
      });
    });
    root.querySelector<HTMLButtonElement>('[data-export]')?.addEventListener('click',()=>{
      const selected=filtered();
      const lines=[labels.join(','),...selected.map(r=>[r.year,...fields.map(f=>r[f])].join(','))];
      const blob=new Blob(['\uFEFF'+lines.join('\r\n')],{type:'text/csv;charset=utf-8;'});
      const url=URL.createObjectURL(blob);
      const a=document.createElement('a');a.href=url;a.download=`major-incidents-${startEl.value}-${endEl.value}.csv`;
      document.body.append(a);a.click();a.remove();URL.revokeObjectURL(url);
    });
    update();
  });
</script>
