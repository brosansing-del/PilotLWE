.mi-breakdowns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.mi-breakdown{min-width:0;border:1px solid #e9dfd0;border-radius:12px;padding:22px;background:linear-gradient(180deg,#fffefb,#f7f3eb)}.mi-breakdown h4{font:500 23px/1.2 Georgia,serif;margin:0 0 18px}.mi-donut{width:154px;height:154px;margin:0 auto 20px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#b84e2c 0% 100%);box-shadow:0 7px 15px rgba(34,44,30,.07)}.mi-donut-center{background:#fffdfa;width:106px;height:106px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px #e8e2d8}.mi-donut-center strong{font:500 27px Georgia,serif;color:#1a4033}.mi-donut-center span{font-size:10px;color:#68776b}.mi-breakdown-row{margin:0 0 13px}.mi-breakdown-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:#5b6a5d;margin-bottom:6px}.mi-breakdown-meta .mi-legend-name{display:inline-flex;align-items:center;gap:7px}.mi-legend-dot{display:inline-block;width:8px;height:8px;border-radius:50%;flex:none}.mi-breakdown-meta strong{color:#1d382f;font-size:10px;font-variant-numeric:tabular-nums;white-space:nowrap}.mi-breakdown-track{height:5px;background:#e8e0d4;border-radius:20px;overflow:hidden}.mi-breakdown-fill{height:100%;border-radius:20px}
.mi-table-hint{font-size:11px;color:#747e73;margin:0 0 12px}.mi-table-scroll{max-width:100%;overflow-x:auto;border:1px solid #e4ded3;border-radius:9px;background:#fff;scrollbar-color:#b6b5a8 #f0ece5}.mi-data-table{border-collapse:separate;border-spacing:0;min-width:1120px;width:100%;font:11px/1.45 system-ui,sans-serif;font-variant-numeric:tabular-nums}.mi-data-table caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.mi-data-table th,.mi-data-table td{padding:11px 10px;border-right:1px solid #e8e5dc;border-bottom:1px solid #e8e5dc;text-align:right;white-space:nowrap}.mi-data-table thead th{position:sticky;top:0;background:#245243;color:#fff;text-align:center;font-weight:750;z-index:2}.mi-data-table thead tr:nth-child(2) th{background:#e5eee5;color:#28483a}.mi-data-table tbody tr[hidden]{display:none}.mi-data-table tbody tr:nth-child(even){background:#faf8f3}.mi-data-table tbody tr:hover{background:#f1eddd}.mi-data-table .mi-sticky{position:sticky;left:0;z-index:1;background:#f4f1e8;text-align:left;box-shadow:1px 0 #e0dbd1}.mi-data-table thead .mi-sticky{z-index:3;background:#245243;color:#fff}.mi-data-table tfoot th,.mi-data-table tfoot td{background:#e2eade;font-weight:800;color:#214537;border-top:2px solid #7b9c87}.mi-data-table tfoot .mi-sticky{background:#e2eade}
.mi-source{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:24px}.mi-source>div{display:flex;align-items:flex-start;gap:13px;padding:21px;border:1px solid #e3d9ca;border-radius:10px;background:#f8f5ee}.mi-source-icon{flex:none;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#e8e4d6;color:#47654e;font-size:17px}.mi-source strong{display:block;color:#2b503f;font-size:11px;font-weight:800;letter-spacing:.05em;margin:0 0 6px}.mi-source p{margin:0;color:#69736b;font-size:11px;line-height:1.7}
.mi-section button:focus-visible,.mi-section select:focus-visible,.mi-table-scroll:focus-visible{outline:3px solid #dc9b55;outline-offset:3px}
