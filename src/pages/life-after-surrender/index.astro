---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
type SurrenderVideo = { id: string; title: string; summary: string; context: string; reviewed: boolean };
const rehabilitationVideos: SurrenderVideo[] = [
  {
    id: 's8zKJ2IODYk',
    title: 'From Rifles to Sewing Machines: A New Life in Konagud',
    summary: 'A video report about former Maoist cadres working at a factory in Konagud and building new livelihoods through tailoring.',
    context: 'Livelihoods · Konagud',
    reviewed: false,
  },
  {
    id: 'fyR4jplJGRY',
    title: 'A Chance at Parenthood: Vasectomy Reversal in Bastar',
    summary: 'A report on sterilisation-reversal procedures for surrendered Maoist cadres seeking to start or expand their families.',
    context: 'Family & rehabilitation · Bastar',
    reviewed: false,
  },
  {
    id: '1kMIIOAQSLE',
    title: 'Fagni’s Journey: From the Underground to Pandum Café',
    summary: 'The supplied video headline follows Fagni, described as a former Maoist medical worker who is now associated with Pandum Café.',
    context: 'New livelihoods · Personal account',
    reviewed: false,
  },
];

const communityVideos: SurrenderVideo[] = [
  {
    id: 'ZPs3vZy_n_0',
    title: 'From Vehicle Burnings to Administrative Camps',
    summary: 'A field report describing the arrival of administrative outreach camps in an area previously affected by Maoist violence.',
    context: 'Governance · Service delivery',
    reviewed: false,
  },
  {
    id: '_aeRRpVZB8I',
    title: 'A Village After Two Decades of Conflict',
    summary: 'The report describes a district collector walking approximately four kilometres to hear residents’ concerns in a conflict-affected village.',
    context: 'Local administration · Community access',
    reviewed: false,
  },
  {
    id: 'xIIu44nAJAQ',
    title: 'Panchayat Elections in Abujhmad, 2025',
    summary: 'A report on changes in local electoral participation and the panchayat election process in Abujhmad.',
    context: 'Local democracy · Abujhmad',
    reviewed: false,
  },
  {
    id: 'vatiFZ1jc_E',
    title: 'Polling Teams Reach Highly Sensitive Areas',
    summary: 'A report on plans to conduct voting in highly sensitive areas and the use of helicopters to deploy polling personnel.',
    context: 'Election access · Remote regions',
    reviewed: false,
  },
];


const youtubeLink = (video: SurrenderVideo) => `https://www.youtube.com/watch?v=${video.id}`;
const youtubeThumbnail = (video: SurrenderVideo) => `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`;

const homeUrl = import.meta.env.BASE_URL;
const total = rehabilitationVideos.length + communityVideos.length;
---

<BaseLayout
  title="Life After Surrender | The Naxal Archive"
  description="Video stories about rehabilitation, livelihoods, family life, governance and civic participation in regions affected by Left-Wing Extremism."
>
  <Header />
  <main class="surrender-page">
    <section class="surrender-hero" aria-labelledby="surrender-title">
      <div class="surrender-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={homeUrl}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Life After Surrender</span>
        </nav>
        <div class="hero-main">
          <div class="eyebrow"><span></span> THE NAXAL ARCHIVE / REINTEGRATION</div>
          <h1 id="surrender-title">Life After <em>Surrender.</em></h1>
          <p class="hero-intro">Beyond the conflict are stories of people rebuilding lives—and communities rediscovering access to services, opportunities and civic institutions.</p>
          <a href="#surrender-stories" class="hero-link">Explore the video stories <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-footer" aria-label="Topics covered"><span>REHABILITATION</span><span>·</span><span>LIVELIHOODS</span><span>·</span><span>COMMUNITY CHANGE</span></div>
      </div>
    </section>

    <section id="surrender-stories" class="stories-intro">
      <div class="surrender-shell intro-grid">
        <div>
          <span class="section-kicker">PERSONAL JOURNEYS</span>
          <h2>New beginnings.<br /><em>New possibilities.</em></h2>
        </div>
        <p>The following reports explore experiences after surrender, including new work, family decisions and the practical process of reintegration. Video titles and summaries reflect the information supplied by contributors and should be checked against the original recordings.</p>
      </div>
    </section>

    <section class="stories-group" aria-labelledby="rehabilitation-title">
      <div class="surrender-shell">
        <div class="group-heading">
          <div><span class="section-kicker">01 / LIFE AFTER THE MOVEMENT</span><h2 id="rehabilitation-title">Rehabilitation &amp; Livelihoods</h2></div>
          <span class="group-count">{String(rehabilitationVideos.length).padStart(2, '0')} VIDEO STORIES</span>
        </div>
        <div class="video-grid">
          {rehabilitationVideos.map((video: SurrenderVideo, index: number) => (
            <article class="video-card">
              <a href={youtubeLink(video)} target="_blank" rel="noopener noreferrer" class="thumbnail" aria-label={`Watch ${video.title} on YouTube`}>
                <img src={youtubeThumbnail(video)} alt={`YouTube thumbnail for ${video.title}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                <span class="thumbnail-fallback" aria-hidden="true">THE NAXAL ARCHIVE</span>
                <span class="play-mark" aria-hidden="true">▶</span>
              </a>
              <div class="card-content">
                <span class="video-context">{video.context}</span>
                <h3><a href={youtubeLink(video)} target="_blank" rel="noopener noreferrer">{video.title}</a></h3>
                <p>{video.summary}</p>
                <a class="watch-link" href={youtubeLink(video)} target="_blank" rel="noopener noreferrer">Watch original on YouTube <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="stories-group community-section" aria-labelledby="community-title">
      <div class="surrender-shell">
        <div class="group-heading">
          <div><span class="section-kicker">02 / CHANGES ON THE GROUND</span><h2 id="community-title">Communities &amp; Civic Life</h2></div>
          <span class="group-count">{String(communityVideos.length).padStart(2, '0')} VIDEO STORIES</span>
        </div>
        <p class="group-description">Reintegration also depends on changing conditions in affected communities. These reports examine public services, administrative outreach and access to local elections.</p>
        <div class="video-grid">
          {communityVideos.map((video: SurrenderVideo) => (
            <article class="video-card">
              <a href={youtubeLink(video)} target="_blank" rel="noopener noreferrer" class="thumbnail" aria-label={`Watch ${video.title} on YouTube`}>
                <img src={youtubeThumbnail(video)} alt={`YouTube thumbnail for ${video.title}`} loading="lazy" decoding="async" />
                <span class="thumbnail-fallback" aria-hidden="true">THE NAXAL ARCHIVE</span>
                <span class="play-mark" aria-hidden="true">▶</span>
              </a>
              <div class="card-content">
                <span class="video-context">{video.context}</span>
                <h3><a href={youtubeLink(video)} target="_blank" rel="noopener noreferrer">{video.title}</a></h3>
                <p>{video.summary}</p>
                <a class="watch-link" href={youtubeLink(video)} target="_blank" rel="noopener noreferrer">Watch original on YouTube <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="source-strip">
      <div class="surrender-shell source-inner"><div><span class="section-kicker">ABOUT THIS COLLECTION</span><h2>{String(total).padStart(2, '0')} stories. Different pathways forward.</h2></div><p>Videos remain hosted by their original YouTube publishers. The descriptions above are preliminary summaries based on supplied headings, not independent verification. Personal and factual details should be reviewed before final public publication.</p></div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .surrender-page{--ink:#24272b;--paper:#f6f1e9;--paper2:#eee6dc;--white:#fffdf9;--dark:#252932;--accent:#a75a37;--gold:#e5b993;--line:#d9d0c4;background:var(--paper);color:var(--ink);font-family:Georgia,'Times New Roman',serif;overflow-x:clip}
  .surrender-page *{box-sizing:border-box}.surrender-shell{width:min(1190px,calc(100% - 48px));margin:0 auto}
  .surrender-hero{background:linear-gradient(125deg,#30313a 0%,#242630 55%,#171d25 100%);color:#fff9f0;padding:34px 0 36px;position:relative;overflow:hidden}
  .surrender-hero:before{content:'';position:absolute;width:530px;height:530px;border:1px solid #ffffff18;border-radius:50%;right:-170px;top:-90px;box-shadow:0 0 0 75px #ffffff06,0 0 0 160px #ffffff04;pointer-events:none}
  .breadcrumbs{display:flex;gap:12px;font:650 12px/1.5 Arial,sans-serif;color:#e2d7ca}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--gold)}
  .hero-main{padding:98px 0 80px;max-width:890px;position:relative}.eyebrow,.section-kicker{font:800 11px/1.5 Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:var(--gold)}.eyebrow{display:flex;align-items:center;gap:12px}.eyebrow span{width:27px;height:2px;background:var(--gold)}
  h1,h2,h3,p{margin-top:0}.hero-main h1{font-size:clamp(52px,7.8vw,104px);letter-spacing:-.055em;line-height:1;max-width:940px;margin:28px 0}.hero-main h1 em{color:var(--gold);font-weight:400}.hero-intro{font:400 clamp(17px,2vw,21px)/1.7 Georgia,serif;max-width:760px;color:#e7ddd2}.hero-link{display:inline-flex;gap:25px;color:#fff5e9;text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:12px;margin-top:20px;font:800 13px/1.4 Arial,sans-serif}.hero-link:hover{color:var(--gold)}.hero-footer{border-top:1px solid #ffffff28;padding-top:22px;display:flex;gap:15px;flex-wrap:wrap;color:#d9bc9e;font:800 10px/1.3 Arial,sans-serif;letter-spacing:.14em}
  .stories-intro{padding:85px 0 58px}.intro-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end}.section-kicker{color:var(--accent)}.intro-grid h2{font-size:clamp(38px,5vw,66px);line-height:1.06;letter-spacing:-.045em;margin:14px 0 0}.intro-grid h2 em{font-weight:400;color:var(--accent)}.intro-grid p{font:400 17px/1.8 Georgia,serif;color:#625c56;margin:0}
  .stories-group{padding:32px 0 95px}.group-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;border-top:1px solid var(--line);padding-top:25px;margin-bottom:30px}.group-heading h2{font-size:clamp(31px,4.1vw,51px);line-height:1.1;letter-spacing:-.035em;margin:9px 0 0}.group-count{font:800 11px/1.4 Arial,sans-serif;color:var(--accent);white-space:nowrap;letter-spacing:.1em}.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.video-card{border:1px solid var(--line);background:var(--white);min-width:0;display:flex;flex-direction:column}.thumbnail{display:block;position:relative;background:linear-gradient(135deg,#353944,#706052);aspect-ratio:16/9;overflow:hidden}.thumbnail img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;z-index:1}.thumbnail-fallback{position:absolute;left:20px;bottom:20px;color:#fff4e5;font:800 12px/1.2 Arial,sans-serif;letter-spacing:.08em}.thumbnail .play-mark{z-index:2;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:56px;height:56px;background:#211d1bc9;color:white;border-radius:50%;font:16px Arial,sans-serif;padding-left:3px;transition:background .2s}.thumbnail:hover .play-mark{background:var(--accent)}.card-content{padding:25px 25px 27px;display:flex;flex-direction:column;flex:1}.video-context{font:800 10px/1.5 Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}.card-content h3{font-size:clamp(23px,2vw,29px);line-height:1.2;letter-spacing:-.02em;margin:13px 0 13px}.card-content h3 a{color:var(--ink);text-decoration:none}.card-content h3 a:hover{text-decoration:underline;text-decoration-color:var(--accent)}.card-content p{font:400 15px/1.7 Georgia,serif;color:#66615b;margin:0 0 24px}.watch-link{margin-top:auto;border-top:1px solid var(--line);padding-top:18px;display:flex;justify-content:space-between;align-items:center;gap:12px;text-decoration:none;color:var(--ink);font:800 12px/1.4 Arial,sans-serif}.watch-link span{font-size:20px;color:var(--accent)}.watch-link:hover{color:var(--accent)}
  .community-section{background:var(--paper2);padding:70px 0 100px}.group-description{font:400 16px/1.7 Georgia,serif;color:#625c56;max-width:740px;margin:-10px 0 32px}.source-strip{padding:66px 0 74px;background:#e6dbcd}.source-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.source-inner h2{font-size:clamp(27px,3vw,40px);line-height:1.13;margin:10px 0 0}.source-inner p{font:400 15px/1.7 Georgia,serif;color:#5d5650;margin:0}
  .thumbnail:focus-visible,.watch-link:focus-visible,.hero-link:focus-visible,.breadcrumbs a:focus-visible,.card-content h3 a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  @media(max-width:950px){.intro-grid{grid-template-columns:1fr;gap:24px}.video-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.source-inner{grid-template-columns:1fr;gap:18px}}
  @media(max-width:620px){.surrender-shell{width:calc(100% - 36px)}.surrender-hero{padding-top:27px}.hero-main{padding:68px 0 55px}.hero-main h1{font-size:clamp(45px,11vw,64px)}.hero-intro{font-size:17px}.hero-footer{font-size:9px}.stories-intro{padding:60px 0 30px}.stories-group{padding:30px 0 65px}.group-heading{align-items:start;flex-direction:column;gap:12px}.video-grid{grid-template-columns:1fr;gap:15px}.community-section{padding:55px 0 70px}.source-strip{padding:48px 0 56px}.card-content{padding:22px}.section-kicker{font-size:10px}}
  @media(prefers-reduced-motion:reduce){.thumbnail .play-mark{transition:none}}
</style>
