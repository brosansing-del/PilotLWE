---
import ArchiveVideoCollection from '../components/ArchiveVideoCollection.astro';
import ArticleShowcase from '../components/ArticleShowcase.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatCard from '../components/StatCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const featuredArticle =
  articles.find((a) => a.data.featured) ?? articles[0];

const latestArticles = articles
  .filter((a) => a.id !== featuredArticle?.id)
  .slice(0, 4);

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const articleUrl = (id: string) =>
  `${BASE}/articles/${id}/`;

const pageUrl = (path: string) =>
  `${BASE}/${path.replace(/^\/+/, '')}`;

const assetUrl = (path: string) =>
  /^(https?:)?\/\//.test(path) || path.startsWith('data:')
    ? path
    : `${BASE}/${path.replace(/^\/+/, '')}`;
---

<BaseLayout>
  <Header />

  <main>

    <!-- ======================================================
         HISTORY / BACKGROUND NAVIGATOR
         ====================================================== -->

    <section class="history-hero" id="background">
      <div class="shell">

        <div class="history-heading">

          <span class="eyebrow">
            Background · History
          </span>

          <h1>
            Five decades of the Naxalite movement, in phases.
          </h1>

          <p>
            Each phase marks a shift in leadership, geography or method —
            not a clean break. Select a phase to continue into the
            historical record.
          </p>

        </div>


        <div class="phase-grid">

          <!-- 01 -->

          <a
            class="phase-card"
           href={pageUrl('background/history/#naxalbari')}
          >
            <span class="phase-number">
              01
            </span>

            <span class="phase-year">
              1967
            </span>

            <h2>
              Naxalbari
            </h2>

            <p>
              A peasant uprising in West Bengal's Darjeeling district
              gives the movement its enduring name and becomes the
              symbolic starting point of the Naxalite movement.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>


          <!-- 02 -->

          <a
            class="phase-card"
            href={pageUrl('background/#cpi-ml')}          >
            <span class="phase-number">
              02
            </span>

            <span class="phase-year">
              1969–72
            </span>

            <h2>
              CPI(ML) and fragmentation
            </h2>

            <p>
              The Communist Party of India (Marxist-Leninist) emerges
              around an armed revolutionary strategy. State action,
              leadership losses and internal divisions fragment the
              organisation within a few years.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>


          <!-- 03 -->

          <a
            class="phase-card"
            href={pageUrl('background/history/#pwg-mcc')}
          >
            <span class="phase-number">
              03
            </span>

            <span class="phase-year">
              1980s
            </span>

            <h2>
              PWG and MCC consolidation
            </h2>

            <p>
              The People's War Group develops a strong base in Andhra
              Pradesh, while the Maoist Communist Centre expands
              separately in Bihar and the adjoining eastern belt.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>


          <!-- 04 -->

          <a
            class="phase-card"
            href={pageUrl('background/history/#convergence')}
          >
            <span class="phase-number">
              04
            </span>

            <span class="phase-year">
              1990s–2004
            </span>

            <h2>
              Expansion and convergence
            </h2>

            <p>
              Insurgent networks expand through forested and tribal
              regions of central and eastern India as major Maoist
              formations move gradually toward organisational convergence.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>


          <!-- 05 -->

          <a
            class="phase-card"
            href={pageUrl('background/history/#cpi-maoist')}
          >
            <span class="phase-number">
              05
            </span>

            <span class="phase-year">
              2004–2010
            </span>

            <h2>
              CPI (Maoist) and wider expansion
            </h2>

            <p>
              The merger of the People's War Group and Maoist Communist
              Centre creates CPI (Maoist), consolidating armed structures
              across a wider geographical belt.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>


          <!-- 06 -->

          <a
            class="phase-card"
            href={pageUrl('background/history/#contraction')}
          >
            <span class="phase-number">
              06
            </span>

            <span class="phase-year">
              2011–Present
            </span>

            <h2>
              Contraction and transformation
            </h2>

            <p>
              Security pressure, leadership losses, surrenders,
              infrastructure expansion and greater administrative access
              reshape the movement's geography and operating space.
            </p>

            <span class="phase-link">
              Explore phase →
            </span>
          </a>

        </div>


        <div class="history-footer">

          <span>
            History · Ideology · Organisation · Geography
          </span>

          <a href={pageUrl('background/')}>
            Explore full background →
          </a>

        </div>

      </div>
    </section>



    <!-- ======================================================
         KEY INDICATORS
         ====================================================== -->

    <section class="section shell">

      <div class="section-head">

        <div>
          <span class="eyebrow">
            Current picture
          </span>

          <h2>
            Key indicators
          </h2>
        </div>

        <p>
          These figures will be populated from validated datasets rather
          than maintained manually in the homepage code.
        </p>

      </div>


      <div class="stats-grid">

        <StatCard
          value="—"
          label="LWE-affected districts"
        />

        <StatCard
          value="—"
          label="Violent incidents, latest year"
        />

        <StatCard
          value="—"
          label="Civilian + security-force deaths"
        />

        <StatCard
          value="—"
          label="Most LWE-affected districts"
        />

      </div>

    </section>



    <!-- ======================================================
         ARTICLES
         ====================================================== -->

    <ArticleShowcase articles={articles} />



    <!-- ======================================================
         DATA & VISUALS
         ====================================================== -->

    <section
      class="section shell"
      id="data-visuals"
    >

      <div class="section-head">

        <div>

          <span class="eyebrow">
            Data & Visuals
          </span>

          <h2>
            Geography, people and infrastructure
          </h2>

        </div>

        <p>
          Interactive datasets covering leadership, surrenders,
          infrastructure, security expansion and geographic change.
        </p>

      </div>


      <div class="visual-placeholder">

        <div>

          <strong>
            Explore the data archive
          </strong>

          <p>
            Searchable records, trends and state-wise datasets built
            from structured source material.
          </p>

        </div>


        <div class="visual-actions">

          <a href={pageUrl('data-visuals/')}>
            Open Data & Visuals →
          </a>

        </div>

      </div>

    </section>



    <!-- ======================================================
         TRACKING DEVELOPMENT
         ====================================================== -->

    <section
      class="section section-dark"
      id="development"
    >

      <div class="shell">

        <div class="section-head light">

          <div>

            <span class="eyebrow">
              Tracking Development
            </span>

            <h2>
              What changes after violence declines?
            </h2>

          </div>

          <p>
            Roads, telecom, banking, education, health,
            rehabilitation and district-level progress.
          </p>

        </div>


        <div class="development-grid">

          <div>

            <strong>
              Roads & connectivity
            </strong>

            <p>
              Year-wise and district-level infrastructure progress.
            </p>

          </div>


          <div>

            <strong>
              Telecom
            </strong>

            <p>
              Network expansion, tower rollout and connectivity.
            </p>

          </div>


          <div>

            <strong>
              Public services
            </strong>

            <p>
              Banking, post offices, education and health access.
            </p>

          </div>


          <div>

            <strong>
              Rehabilitation
            </strong>

            <p>
              Surrenders, rehabilitation packages and reintegration indicators.
            </p>

          </div>

        </div>

      </div>

    </section>



    <!-- ======================================================
         METHODOLOGY
         ====================================================== -->

    <section
      class="section shell"
      id="methodology"
    >

      <div class="section-head">

        <div>

          <span class="eyebrow">
            Methodology
          </span>

          <h2>
            Three rules for every published figure
          </h2>

        </div>

      </div>


      <div class="method-grid">

        <div>

          <span>
            01 / SOURCE
          </span>

          <h3>
            Primary before secondary
          </h3>

          <p>
            Official records, court documents and first-hand reporting
            are prioritised wherever available.
          </p>

        </div>


        <div>

          <span>
            02 / DATE
          </span>

          <h3>
            Every figure carries a reporting date
          </h3>

          <p>
            Administrative classifications and official totals change
            over time and are presented with their reporting period.
          </p>

        </div>


        <div>

          <span>
            03 / VERIFICATION
          </span>

          <h3>
            Claims are cross-checked
          </h3>

          <p>
            Conflicting figures, data gaps and important uncertainty
            are made visible rather than silently reconciled.
          </p>

        </div>

      </div>

    </section>


    <script>
      document.querySelectorAll('[data-article-carousel]').forEach((carousel) => {
        const track = carousel.querySelector('[data-carousel-track]');
        const viewport = carousel.querySelector('[data-carousel-viewport]');
        const slides = Array.from(carousel.querySelectorAll('.article-carousel-slide'));
        const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'));
        const count = carousel.querySelector('[data-carousel-count]');
        const prev = carousel.querySelector('[data-carousel-prev]');
        const next = carousel.querySelector('[data-carousel-next]');
        if (!track || !viewport || slides.length === 0) return;

        let current = 0;
        let startX = null;
        let startY = null;

        const show = (index) => {
          current = (index + slides.length) % slides.length;
          track.style.transform = `translateX(-${current * 100}%)`;
          slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === current ? 'false' : 'true'));
          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === current);
            dot.setAttribute('aria-current', i === current ? 'true' : 'false');
          });
          if (count) count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        };

        prev?.addEventListener('click', () => show(current - 1));
        next?.addEventListener('click', () => show(current + 1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

        viewport.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          startX = event.clientX;
          startY = event.clientY;
        });
        viewport.addEventListener('pointerup', (event) => {
          if (startX === null || startY === null) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          startX = null; startY = null;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
        });
        viewport.addEventListener('pointercancel', () => { startX = null; startY = null; });

        carousel.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') show(current - 1);
          if (event.key === 'ArrowRight') show(current + 1);
        });
      });
    </script>

  
    <!-- ARCHIVE VOICES: homepage preview -->
    <ArchiveVideoCollection mode="home" />
  </main>

  <Footer />

</BaseLayout>



<style>

  /* ======================================================
     HISTORY HOMEPAGE
     ====================================================== */

  .history-hero {
    background: #f3efe5;
    color: #111b20;

    padding:
      70px
      0
      62px;
  }


  .history-heading {
    max-width: 880px;

    margin-bottom: 46px;
  }


  .history-heading h1 {
    margin:
      10px
      0
      20px;

    max-width: 840px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        48px,
        6.2vw,
        82px
      );

    font-weight: 700;

    line-height: .96;

    letter-spacing: -.042em;
  }


  .history-heading p {
    max-width: 720px;

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 19px;

    line-height: 1.55;

    color: #62635f;
  }


  /* PHASE GRID */

  .phase-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    border-top:
      1px solid #cec6b8;

    border-left:
      1px solid #cec6b8;
  }


  .phase-card {
    position: relative;

    min-width: 0;

    min-height: 350px;

    display: flex;

    flex-direction: column;

    padding: 28px;

    border-right:
      1px solid #cec6b8;

    border-bottom:
      1px solid #cec6b8;

    background: #fffdf8;

    color: #111b20;

    text-decoration: none;

    transition:
      background .2s ease,
      color .2s ease;
  }


  .phase-number {
    position: absolute;

    top: 27px;
    right: 27px;

    font-family:
      system-ui,
      sans-serif;

    font-size: 10px;

    font-weight: 800;

    color: #aaa397;

    letter-spacing: .08em;
  }


  .phase-year {
    margin-bottom: 40px;

    font-family:
      system-ui,
      sans-serif;

    font-size: 11px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .12em;

    color: #a34f32;
  }


  .phase-card h2 {
    margin:
      0
      0
      16px;

    max-width: 280px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 30px;

    line-height: 1.04;

    letter-spacing: -.025em;
  }


  .phase-card p {
    margin:
      0
      0
      30px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 15px;

    line-height: 1.56;

    color: #68655f;
  }


  .phase-link {
    margin-top: auto;

    font-family:
      system-ui,
      sans-serif;

    font-size: 11px;

    font-weight: 800;

    color: #111b20;

    letter-spacing: .025em;
  }


  /* DESKTOP HOVER */

  @media
  (hover: hover)
  and
  (pointer: fine) {

    .phase-card:hover {
      background: #172327;
      color: #fffdf8;
    }


    .phase-card:hover
    .phase-year {
      color: #d69b78;
    }


    .phase-card:hover
    .phase-number {
      color: #879294;
    }


    .phase-card:hover
    p {
      color: #d1d5d4;
    }


    .phase-card:hover
    .phase-link {
      color: #fffdf8;
    }

  }


  /* BOTTOM LINK */

  .history-footer {
    display: flex;

    justify-content:
      space-between;

    align-items: center;

    gap: 30px;

    padding-top: 26px;
  }


  .history-footer > span {
    font-family:
      system-ui,
      sans-serif;

    font-size: 10px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .1em;

    color: #837c71;
  }


  .history-footer a {
    color: #111b20;

    text-decoration: none;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 18px;

    font-weight: 700;
  }


  /* ======================================================
     TABLET
     ====================================================== */

  @media (max-width: 900px) {

    .phase-grid {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

  }


  /* ======================================================
     IPHONE / MOBILE
     ====================================================== */

  @media (max-width: 600px) {

    .history-hero {
      padding:
        42px
        0
        46px;
    }


    .history-heading {
      margin-bottom: 30px;
    }


    .history-heading h1 {
      font-size: 45px;

      line-height: .98;
    }


    .history-heading p {
      font-size: 17px;

      line-height: 1.5;
    }


    .phase-grid {
      grid-template-columns: 1fr;
    }


    .phase-card {
      min-height: 275px;

      padding: 25px;
    }


    .phase-number {
      top: 24px;

      right: 24px;
    }


    .phase-year {
      margin-bottom: 26px;
    }


    .phase-card h2 {
      font-size: 29px;
    }


    .history-footer {
      align-items: flex-start;

      flex-direction: column;

      gap: 14px;
    }

  }

</style>
