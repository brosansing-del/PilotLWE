---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// Every article appears once in the same compact grid, including featured stories.
const articles = (await getCollection('articles')).sort((a, b) => {
  const featuredDifference = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
  if (featuredDifference) return featuredDifference;
  return new Date(b.data.published).valueOf() - new Date(a.data.published).valueOf();
});

type Article = (typeof articles)[number];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url = (path: string) => `${base}/${path.replace(/^\/+/, '')}`;
const asset = (path: string) => /^(https?:)?\/\//.test(path) || path.startsWith('data:') ? path : url(path);
const data = (item: Article) => item.data as Record<string, any>;
// Keep the original artwork visible even if article metadata omits a cover field.
// Other articles continue to use their existing cover/image/heroImage values.
const opinionsCoverImages: Record<string, string> = {
  'who-stole-their-childhoods': '/images/articles/children-of-maoists.webp',
  'whose-liberation-after-all': '/images/articles/whose-liberation.webp',
};
const imageFor = (item: Article) => {
  const image = opinionsCoverImages[item.id] || data(item).cover || data(item).image || data(item).heroImage || '';
  return typeof image === 'string' ? (image ? asset(image) : '') : image?.src || '';
};
const descriptionFor = (item: Article) => String(data(item).dek || data(item).description || data(item).excerpt || '');
const categoryFor = (item: Article) => String(data(item).section || 'Opinions');
const dateFor = (item: Article) => new Date(data(item).published).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric'
});
const categories = [...new Set(articles.map(categoryFor))].sort((a, b) => {
  if (a === 'Opinions') return -1;
  if (b === 'Opinions') return 1;
  return a.localeCompare(b);
});

// The quoted testimony comes from the existing article's own Markdown body.
// No changes to the article text, frontmatter or content schema are required.
const quoteFor = (item: Article) => {
  // Quote cards read the existing Markdown; Sameela's card shows a short excerpt.
  const id = item.id;
  if (id !== 'who-stole-their-childhoods' && id !== 'whose-liberation-after-all') return null;

  const body = String((item as any).body || '');
  const quotedLine = body.split(/\r?\n/).find(line => /^\s*>\s*[“"‘']/.test(line));
  if (quotedLine) {
    const raw = quotedLine.replace(/^\s*>\s*/, '').trim();
    const separator = raw.lastIndexOf(' — ');
    if (separator > -1) {
      const words = raw.slice(0, separator).trim();
      const credit = raw.slice(separator + 3)
        .replace(/,?\s*as quoted in (?:the )?(?:supplied )?article\.?$/i, '')
        .trim();

      if (id === 'whose-liberation-after-all') {
        const excerpt = words.match(/I wanted to keep the child, but that was not my decision to make/i);
        if (excerpt) return { words: '“' + excerpt[0] + '…”', credit: credit || 'Sameela, Narayanpur' };
      }
      return { words, credit };
    }
  }

  // Fallbacks are taken from the previously supplied article text.
  if (id === 'whose-liberation-after-all') {
    return {
      words: '“I wanted to keep the child, but that was not my decision to make…”',
      credit: 'Sameela, Narayanpur'
    };
  }
  return {
    words: '“I was 12 when I heard my ma was killed in an encounter. I never saw her. And I never understood why she left.”',
    credit: 'Badru'
  };
};
---
<BaseLayout>
  <Header />
  <main class="na-library" id="main-content">
    <div class="na-library-shell">
      <nav class="na-library-breadcrumb" aria-label="Breadcrumb">
        <a href={url('')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Opinions</span>
      </nav>

      <header class="na-library-intro">
        <span class="na-kicker">THE NAXAL ARCHIVE / EDITORIAL</span>
        <h1>Perspectives <em>&amp; Voices.</em></h1>
        <p>Analysis, opinions and interviews exploring the history, ideas and human experiences behind Left-Wing Extremism.</p>
      </header>

      <section class="na-library-collection" aria-label="Browse opinions and editorial articles">
        <div class="na-library-toolbar">
          <span class="na-toolbar-label">EXPLORE THE COLLECTION</span>
          <div class="na-library-filter" data-na-article-filters aria-label="Filter articles by category">
            <button type="button" data-na-category="all" class="is-selected" aria-pressed="true">All</button>
            {categories.map(category => (
              <button type="button" data-na-category={category} aria-pressed="false">{category}</button>
            ))}
          </div>
        </div>

        {articles.length > 0 ? (
          <div class="na-library-grid">
            {articles.map(item => {
              const quote = quoteFor(item);
              return (
                <article class="na-article-tile" data-na-tile data-na-section={categoryFor(item)}>
                  <a class="na-tile-image" href={url(`articles/${item.id}/`)} aria-label={`Read ${data(item).title}`}>
                    {imageFor(item) ? (
                      <img src={imageFor(item)} alt={`Cover image for ${data(item).title}`} loading="lazy" decoding="async" />
                    ) : (
                      <span class="na-placeholder">THE NAXAL ARCHIVE</span>
                    )}
                  </a>
                  <div class="na-tile-text">
                    <div class="na-tile-meta">
                      <span>{categoryFor(item)}</span><span aria-hidden="true">·</span><time>{dateFor(item)}</time>
                    </div>
                    <h2><a href={url(`articles/${item.id}/`)}>{data(item).title}</a></h2>
                    {quote ? (
                      <blockquote class="na-tile-quote">
                        <p>{quote.words}</p>
                        <cite>— {quote.credit}</cite>
                      </blockquote>
                    ) : (
                      <p class="na-tile-description">{descriptionFor(item)}</p>
                    )}
                    <a class="na-tile-link" href={url(`articles/${item.id}/`)}>
                      Read article <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="na-library-empty">Articles and perspectives will appear here as they are published.</p>
        )}
        <p class="na-library-empty" data-na-no-match hidden>No articles in this category yet. Select All to see the full collection.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-na-article-filters]');
  if (toolbar) {
    const buttons = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-na-category]'));
    const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-na-tile]'));
    const empty = document.querySelector<HTMLElement>('[data-na-no-match]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const value = button.dataset.naCategory || 'all';
      buttons.forEach(other => {
        const selected = other === button;
        other.classList.toggle('is-selected', selected);
        other.setAttribute('aria-pressed', String(selected));
      });
      let visible = 0;
      tiles.forEach(tile => {
        const match = value === 'all' || tile.dataset.naSection === value;
        tile.hidden = !match;
        if (match) visible++;
      });
      if (empty) empty.hidden = visible !== 0 || tiles.length === 0;
    }));
  }
</script>

<style>
  .na-library{background:#f3efe6;color:#1c3028;min-height:80vh;padding:18px 0 68px;}
  .na-library *{box-sizing:border-box;}
  .na-library-shell{width:min(1180px,calc(100% - 48px));margin:0 auto;}
  .na-library-breadcrumb{display:flex;gap:12px;align-items:center;font:650 11px/1.4 system-ui,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#849087;}
  .na-library-breadcrumb a{color:#48665a;text-decoration:none;}
  .na-library-breadcrumb a:hover{color:#a95a3d;}
  .na-kicker{font:800 10px/1.5 system-ui,sans-serif;letter-spacing:.16em;color:#ac5a3c;}
  .na-library-intro{padding:43px 0 31px;max-width:1000px;}
  .na-library-intro h1{font:500 clamp(42px,5vw,66px)/1.06 Georgia,'Times New Roman',serif;letter-spacing:-.045em;margin:11px 0 15px;text-wrap:balance;}
  .na-library-intro h1 em{color:#a65b41;font-weight:400;}
  .na-library-intro p{color:#59685f;font:17px/1.6 Georgia,serif;max-width:760px;margin:0;}
  .na-library-toolbar{border-top:1px solid #d4cbbf;border-bottom:1px solid #d4cbbf;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 0;margin-bottom:20px;}
  .na-toolbar-label{font:800 10px/1.4 system-ui,sans-serif;letter-spacing:.13em;color:#a65b41;}
  .na-library-filter{display:flex;align-items:center;flex-wrap:wrap;gap:7px;}
  .na-library-filter button{border:1px solid #cbc8bd;border-radius:99px;background:transparent;color:#405b4f;padding:8px 14px;font:700 11px/1.2 system-ui,sans-serif;cursor:pointer;transition:background .2s,color .2s,border-color .2s;}
  .na-library-filter button.is-selected,.na-library-filter button:hover{background:#204437;border-color:#204437;color:#fff;}
  .na-library-filter button:focus-visible{outline:3px solid #ba785e;outline-offset:3px;}
  .na-library-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:stretch;}
  .na-article-tile{min-width:0;display:flex;flex-direction:column;overflow:hidden;background:#fffcf6;border:1px solid #ddd4c7;box-shadow:0 5px 15px rgba(28,41,31,.025);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;}
  .na-article-tile[hidden]{display:none!important;}
  .na-article-tile:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(28,41,31,.095);border-color:#c7ae99;}
  .na-tile-image{display:block;aspect-ratio:16/10;overflow:hidden;background:#25483c;position:relative;}
  .na-tile-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease;}
  .na-tile-image:hover img{transform:scale(1.04);}
  .na-placeholder{display:grid;place-items:center;height:100%;color:#f5ede0;font:800 11px system-ui,sans-serif;letter-spacing:.12em;}
  .na-tile-text{padding:22px 23px 20px;display:flex;flex:1;flex-direction:column;min-width:0;}
  .na-tile-meta{display:flex;flex-wrap:wrap;gap:9px;align-items:center;color:#a85b40;font:800 10px/1.5 system-ui,sans-serif;letter-spacing:.09em;text-transform:uppercase;}
  .na-tile-meta time{color:#7d8177;font-weight:600;letter-spacing:.02em;text-transform:none;}
  .na-tile-text h2{font:500 clamp(23px,2.05vw,28px)/1.18 Georgia,serif;letter-spacing:-.025em;margin:13px 0 13px;overflow-wrap:break-word;}
  .na-tile-text h2 a{color:#1b3128;text-decoration:none;}
  .na-tile-text h2 a:hover{color:#a85b40;}
  .na-tile-description{font:15px/1.65 Georgia,serif;color:#606d62;margin:0 0 22px;}
  .na-tile-quote{margin:0 0 22px;padding:0 0 0 14px;border-left:3px solid #b66a4a;color:#526458;}
  .na-tile-quote p{font:italic 15px/1.55 Georgia,serif;margin:0 0 8px;}
  .na-tile-quote cite{display:block;font:600 10px/1.5 system-ui,sans-serif;color:#a05a42;font-style:normal;}
  .na-tile-link{margin-top:auto;padding-top:14px;border-top:1px solid #e2dcd1;display:flex;align-items:center;justify-content:space-between;color:#245044;font:800 12px/1.3 system-ui,sans-serif;text-decoration:none;}
  .na-tile-link span{font-size:16px;color:#a75a40;}
  .na-tile-link:hover{color:#a85b40;}
  .na-library-empty{padding:24px 18px;color:#5e6e62;background:#fffcf6;border:1px solid #ddd4c7;font:15px/1.6 Georgia,serif;}
  .na-library-empty[hidden]{display:none!important;}
  @media(max-width:960px){.na-library-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.na-library-intro{padding-top:38px;}}
  @media(max-width:640px){.na-library{padding:16px 0 48px;}.na-library-shell{width:calc(100% - 32px);}.na-library-intro{padding:29px 0 25px;}.na-library-intro h1{font-size:clamp(39px,9vw,52px);}.na-library-intro p{font-size:16px;}.na-library-toolbar{align-items:flex-start;flex-direction:column;gap:12px;}.na-library-grid{grid-template-columns:1fr;gap:16px;}.na-tile-text{padding:20px;}.na-tile-text h2{font-size:25px;}}
  @media(prefers-reduced-motion:reduce){.na-article-tile,.na-tile-image img,.na-library-filter button{transition:none;}}
</style>
