---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import * as contentApi from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await contentApi.getCollection('articles');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'articles'> };
// Compatible with both modern Astro content collections and older entry.render() collections.
const api: any = contentApi;
const rendered = typeof api.render === 'function' ? await api.render(entry) : await (entry as any).render();
const Content = rendered.Content;
const d = entry.data as Record<string, any>;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url = (s: string) => `${base}/${s.replace(/^\/+/, '')}`;
const asset = (s: string) => /^(https?:)?\/\//.test(s) || s.startsWith('data:') ? s : url(s);
const coverValue = d.cover || d.image || d.heroImage || '';
const cover = typeof coverValue === 'string' ? (coverValue ? asset(coverValue) : '') : coverValue?.src || '';
const summary = d.dek || d.description || d.excerpt || '';
const published = d.published instanceof Date ? d.published : new Date(d.published);
const dateLabel = published.toLocaleDateString('en-IN', { day:'numeric',month:'long',year:'numeric' });
const raw = String((entry as any).body || '');
const wordCount = raw.replace(/[#*_>`|[\]()]/g, ' ').split(/\s+/).filter(Boolean).length;
const reading = d.readTime || `${Math.max(3, Math.ceil(wordCount / 220))} min read`;
const others = (await contentApi.getCollection('articles')).filter(item => item.id !== entry.id).sort((a,b) => new Date(b.data.published).valueOf() - new Date(a.data.published).valueOf()).slice(0,2);
const otherImage = (item: CollectionEntry<'articles'>) => {
  const x = item.data as Record<string, any>;
  const v = x.cover || x.image || '';
  return typeof v === 'string' ? (v ? asset(v) : '') : v?.src || '';
};
---
<BaseLayout>
  <Header />
  <div class="na-progress" aria-hidden="true"><span data-na-progress></span></div>
  <main class="na-reader" id="main-content">
    <div class="na-reader-shell">
      <nav class="na-crumbs" aria-label="Breadcrumb"><a href={url('')}>Home</a><span>/</span><a href={url('articles/')}>Articles</a><span>/</span><span>{d.section || 'Editorial'}</span></nav>
      <header class="na-story-head">
        <div class="na-story-label"><span class="na-story-spark">✳</span> {String(d.section || 'Articles').toUpperCase()} <span class="na-story-sep">·</span> {String(d.type || 'Article').toUpperCase()}</div>
        <h1>{d.title}</h1>
        {summary && <p class="na-story-dek">{summary}</p>}
        <div class="na-story-meta">
          <div class="na-avatar" aria-hidden="true">N</div>
          <div><strong>{d.author || 'The Naxal Archive'}</strong><span>Published {dateLabel} <i aria-hidden="true">·</i> {reading}</span></div>
          <button type="button" class="na-share" data-na-copy aria-label="Copy link to article"><span aria-hidden="true">↗</span> Share article</button>
        </div>
      </header>
      {cover && (
        <figure class="na-cover">
          <img src={cover} alt={`Cover image for ${d.title}`} decoding="async" fetchpriority="high" />
          <figcaption><span>THE NAXAL ARCHIVE</span><span>Cover image for illustration</span></figcaption>
        </figure>
      )}
      <div class="na-reading-grid">
        <article class="na-prose-article" aria-label={d.title}>
          <div class="na-reader-prose"><Content /></div>
          <div class="na-endmark" aria-hidden="true">❖</div>
          <div class="na-article-bottom">
            <span>THE NAXAL ARCHIVE / {String(d.section || 'Articles').toUpperCase()}</span>
            <a href={url('articles/')}>← All articles</a>
          </div>
        </article>
        <aside class="na-sidebar" aria-label="Explore the archive">
          <div class="na-side-sticky">
            <span class="na-side-kicker">ABOUT THIS ARCHIVE</span>
            <h2>History in context.<br/><em>People in focus.</em></h2>
            <p>Perspectives and documentation that examine the historical record and its human consequences.</p>
            <a href={url('articles/')}>Explore the collection <span aria-hidden="true">↗</span></a>
            <div class="na-side-rule"></div>
            <span class="na-side-kicker">READING TIME</span>
            <div class="na-side-reading">{reading}</div>
          </div>
        </aside>
      </div>
      {others.length > 0 && <section class="na-related" aria-labelledby="na-related-title">
        <div class="na-related-head"><div><span class="na-side-kicker">CONTINUE EXPLORING</span><h2 id="na-related-title">Further reading</h2></div><a href={url('articles/')}>View all articles ↗</a></div>
        <div class="na-related-grid">
          {others.map(item => (
            <a class="na-related-card" href={url(`articles/${item.id}/`)}>
              <div class="na-related-img">{otherImage(item) ? <img src={otherImage(item)} alt={`Cover for ${item.data.title}`} loading="lazy" /> : <span>THE NAXAL ARCHIVE</span>}</div>
              <div class="na-related-copy"><span class="na-side-kicker">{String((item.data as Record<string, any>).section || 'Articles').toUpperCase()}</span><h3>{item.data.title}</h3><span class="na-related-link">Read story <b aria-hidden="true">↗</b></span></div>
            </a>
          ))}
        </div>
      </section>}
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('[data-na-progress]');
  const article = document.querySelector<HTMLElement>('.na-prose-article');
  if (progress && article) {
    let scheduled = false;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const contentHeight = article.offsetHeight;
      const travelled = -rect.top + window.innerHeight * .35;
      const range = Math.max(1,contentHeight - window.innerHeight * .35);
      progress.style.width = `${Math.max(0,Math.min(100,travelled / range * 100))}%`;
      scheduled = false;
    };
    window.addEventListener('scroll',() => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(update); }
    },{ passive:true });
    window.addEventListener('resize',update);
    update();
  }
  document.querySelector<HTMLButtonElement>('[data-na-copy]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const textBefore = button.textContent || 'Share article';
    try {
      await navigator.clipboard.writeText(window.location.href);
      button.textContent = 'Link copied ✓';
      button.setAttribute('aria-label','Article link copied');
    } catch {
      button.textContent = 'Copy from address bar';
    }
    window.setTimeout(() => { button.textContent = textBefore; button.setAttribute('aria-label','Copy link to article'); },2500);
  });
</script>

<style>
  .na-reader{background:#f4f0e7;color:#1b2c25;min-height:100vh;padding:27px 0 100px;}
  .na-reader *{box-sizing:border-box;}
  .na-reader-shell{width:min(1140px,calc(100% - 56px));margin:0 auto;}
  .na-progress{position:sticky;top:0;z-index:55;height:3px;background:transparent;}
  .na-progress span{display:block;background:#b35f41;height:100%;width:0;transition:width .1s linear;}
  .na-crumbs{display:flex;gap:13px;align-items:center;flex-wrap:wrap;font:700 10px/1.5 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.11em;color:#929891;}
  .na-crumbs a{color:#517065;text-decoration:none;}
  .na-crumbs a:hover{color:#aa5839;}
  .na-story-head{max-width:950px;margin:57px auto 48px;text-align:center;}
  .na-story-label{font:700 11px/1.6 system-ui,sans-serif;letter-spacing:.16em;color:#a55439;}
  .na-story-spark{font-size:21px;vertical-align:-3px;margin-right:4px;}
  .na-story-sep{color:#aaa69b;padding:0 8px;}
  .na-story-head h1{font:500 clamp(42px,5.2vw,70px)/1.07 Georgia,serif;letter-spacing:-.044em;max-width:950px;margin:19px auto 23px;text-wrap:balance;}
  .na-story-dek{font:19px/1.6 Georgia,serif;max-width:750px;margin:0 auto 26px;color:#617068;}
  .na-story-meta{display:flex;align-items:center;justify-content:center;gap:12px;border-top:1px solid #d5d7cd;border-bottom:1px solid #d5d7cd;max-width:675px;margin:35px auto 0;padding:15px 4px;text-align:left;}
  .na-avatar{width:39px;height:39px;border-radius:50%;background:#24483a;display:grid;place-items:center;color:#f4efe3;font:24px Georgia,serif;flex:none;}
  .na-story-meta div:nth-child(2){display:flex;flex-direction:column;gap:3px;}
  .na-story-meta strong{font:700 12px/1.3 system-ui,sans-serif;color:#274539;}
  .na-story-meta span{color:#829086;font:11px/1.45 system-ui,sans-serif;}
  .na-story-meta i{font-style:normal;padding:0 4px;}
  .na-share{margin-left:auto;background:transparent;border:1px solid #c8d0c3;border-radius:30px;color:#31594a;cursor:pointer;white-space:nowrap;padding:11px 15px;font:700 11px/1.2 system-ui,sans-serif;}
  .na-share span{margin-right:5px;}
  .na-share:hover{background:#234637;color:white;}
  .na-cover{margin:0 0 55px;}
  .na-cover img{display:block;width:100%;height:auto;max-height:530px;aspect-ratio:16/8.5;object-fit:cover;background:#193a31;}
  .na-cover figcaption{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid #dddcd2;padding:11px 2px;font:600 10px/1.4 system-ui,sans-serif;color:#8d948c;letter-spacing:.06em;}
  .na-reading-grid{display:grid;grid-template-columns:minmax(0,730px) minmax(210px,270px);justify-content:space-between;gap:55px;}
  .na-prose-article{min-width:0;}
  .na-reader-prose{font:19px/1.85 Georgia,'Times New Roman',serif;color:#26322b;overflow-wrap:break-word;}
  .na-reader-prose :global(p){margin:0 0 1.45em;}
  .na-reader-prose :global(p:first-of-type){font-size:1.13em;line-height:1.75;color:#21342b;}
  .na-reader-prose :global(h2){font:500 34px/1.2 Georgia,serif;letter-spacing:-.025em;margin:1.65em 0 .55em;color:#193c30;}
  .na-reader-prose :global(h3){font:600 25px/1.3 Georgia,serif;margin:1.5em 0 .5em;color:#193c30;}
  .na-reader-prose :global(blockquote){border-left:4px solid #aa6447;background:#ebe5da;padding:28px 30px 29px;margin:42px 0;color:#254539;font:italic 22px/1.65 Georgia,serif;}
  .na-reader-prose :global(blockquote p){margin:0;}
  .na-reader-prose :global(strong){color:#183a2e;}
  .na-reader-prose :global(a){color:#a55438;text-underline-offset:4px;}
  .na-reader-prose :global(img){max-width:100%;height:auto;margin:20px auto;display:block;}
  .na-reader-prose :global(ul),.na-reader-prose :global(ol){padding-left:26px;margin:25px 0;}
  .na-reader-prose :global(li){margin-bottom:10px;}
  .na-reader-prose :global(hr){border:0;border-top:1px solid #d4d3c9;margin:44px 0;}
  .na-endmark{text-align:center;font:34px Georgia,serif;color:#aa5e40;margin:38px 0;}
  .na-article-bottom{display:flex;justify-content:space-between;gap:18px;border-top:1px solid #d2d8ce;padding:22px 0 10px;font:700 10px/1.5 system-ui,sans-serif;letter-spacing:.08em;color:#839087;}
  .na-article-bottom a{color:#285341;text-decoration:none;}
  .na-sidebar{border-left:1px solid #d9dad0;padding-left:31px;}
  .na-side-sticky{position:sticky;top:50px;}
  .na-side-kicker{font:700 10px/1.5 system-ui,sans-serif;letter-spacing:.14em;color:#a55d40;}
  .na-sidebar h2{font:500 29px/1.22 Georgia,serif;letter-spacing:-.025em;margin:21px 0 13px;}
  .na-sidebar h2 em{color:#a35c42;font-weight:400;}
  .na-sidebar p{font:15px/1.7 Georgia,serif;color:#6d776f;margin:0 0 21px;}
  .na-sidebar a{font:700 12px system-ui,sans-serif;color:#214536;text-decoration:none;display:flex;justify-content:space-between;border-bottom:1px solid #c5d0c5;padding-bottom:12px;}
  .na-side-rule{height:1px;background:#d5d7cc;margin:31px 0 21px;}
  .na-side-reading{font:23px Georgia,serif;margin-top:8px;color:#315142;}
  .na-related{border-top:1px solid #d2d6ca;padding-top:39px;margin-top:79px;}
  .na-related-head{display:flex;justify-content:space-between;gap:18px;align-items:end;margin-bottom:22px;}
  .na-related-head h2{font:500 42px/1.15 Georgia,serif;letter-spacing:-.035em;margin:9px 0 0;}
  .na-related-head a{font:700 12px system-ui,sans-serif;text-decoration:none;color:#305647;}
  .na-related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:21px;}
  .na-related-card{display:grid;grid-template-columns:43% 57%;min-width:0;background:#fffdf7;border:1px solid #dad9cf;color:inherit;text-decoration:none;min-height:190px;}
  .na-related-img{overflow:hidden;background:#214e3d;color:#fff;position:relative;display:flex;align-items:center;justify-content:center;font:14px Georgia,serif;}
  .na-related-img img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .3s;}
  .na-related-card:hover img{transform:scale(1.04);}
  .na-related-copy{padding:23px;display:flex;flex-direction:column;}
  .na-related-copy h3{font:500 24px/1.2 Georgia,serif;letter-spacing:-.025em;margin:13px 0 16px;}
  .na-related-link{margin-top:auto;font:700 11px system-ui,sans-serif;color:#315c49;}
  .na-related-link b{float:right;font-size:15px;}
  @media(max-width:940px){.na-reading-grid{grid-template-columns:minmax(0,1fr) 220px;gap:30px;}.na-sidebar{padding-left:23px;}.na-related-card{grid-template-columns:1fr;}.na-related-img{aspect-ratio:16/9;}}
  @media(max-width:700px){.na-reader{padding:20px 0 65px;}.na-reader-shell{width:calc(100% - 34px);}.na-story-head{margin:40px auto 30px;}.na-story-head h1{font-size:clamp(40px,10vw,54px);}.na-story-dek{font-size:17px;}.na-story-meta{flex-wrap:wrap;}.na-share{padding:9px 12px;}.na-cover{margin-bottom:35px;}.na-cover img{aspect-ratio:16/10;}.na-reading-grid{grid-template-columns:1fr;}.na-sidebar{display:none;}.na-reader-prose{font-size:18px;line-height:1.8;}.na-reader-prose :global(blockquote){font-size:20px;padding:22px 20px;margin:30px 0;}.na-related{margin-top:55px;}.na-related-grid{grid-template-columns:1fr;}.na-related-card{grid-template-columns:40% 60%;min-height:160px;}.na-related-img{aspect-ratio:auto;}.na-related-head h2{font-size:34px;}}
  @media(max-width:420px){.na-share{width:100%;text-align:center;margin-top:8px;}.na-story-meta{justify-content:flex-start;}.na-related-card{grid-template-columns:1fr;}.na-related-img{aspect-ratio:16/9;}.na-article-bottom{flex-direction:column;}}
</style>
